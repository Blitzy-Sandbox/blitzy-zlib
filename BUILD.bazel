# This BUILD file describes only the C reference implementation of zlib: the
# `:z` library below and its `:zlib` alias, compiled from the 15 C translation
# units in this directory.  Those sources are retained here unmodified on
# purpose.  They are the differential oracle for the memory-safe Rust
# reimplementation of this library -- the Rust encoder's output is compared
# byte-for-byte against theirs -- so this build has to stay green: if it broke,
# the Rust implementation would lose the reference it is checked against.
#
# The Rust implementation is not built by Bazel.  It is a Cargo workspace rooted at
# Cargo.toml with three members: crates/zlib-rs, the dependency-free safe core
# holding all of the algorithmic logic; crates/libz-rs-sys, the C ABI facade
# whose `z` library target produces the drop-in libz.so and libz.a; and
# crates/zlib-rs-differential, the dev-only harness that compiles the C sources
# above alongside the Rust ones so the two can be compared in one process.
# Build it with `cargo build --release`.
#
# Rust is deliberately out of Bazel scope.  No Rust ruleset is loaded here and
# none is requested in MODULE.bazel, which carries only a matching note.  Adding
# one would mean maintaining a second build description of the same library by
# hand, in step with Cargo.toml, and no such ruleset is among this module's
# dependencies.
#
# None of this changes anything for a Bazel consumer.  Both implementations
# export the same C ABI -- identical symbols, signatures and struct layouts,
# all fixed by the immutable zlib.h and zconf.h -- so `:z` and `:zlib` keep
# behaving exactly as they always have.  Depend on them as before, and do not
# add Rust targets to this package.
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Zlib"],
    license_text = "LICENSE",
)

exports_files([
    "LICENSE",
])

_ZLIB_HEADERS = [
    "crc32.h",
    "deflate.h",
    "gzguts.h",
    "inffast.h",
    "inffixed.h",
    "inflate.h",
    "inftrees.h",
    "trees.h",
    "zconf.h",
    "zlib.h",
    "zutil.h",
]

_ZLIB_PREFIXED_HEADERS = ["zlib/include/" + hdr for hdr in _ZLIB_HEADERS]

# In order to limit the damage from the `includes` propagation
# via `:zlib`, copy the public headers to a subdirectory and
# expose those.
genrule(
    name = "copy_public_headers",
    srcs = _ZLIB_HEADERS,
    outs = _ZLIB_PREFIXED_HEADERS,
    cmd_bash = "cp $(SRCS) $(@D)/zlib/include/",
    cmd_bat = " && ".join(
        ["@copy /Y \"$(location %s)\" \"$(@D)\\zlib\\include\\\"  >NUL" %
         s for s in _ZLIB_HEADERS],
    ),
)

config_setting(
    name = "mingw_gcc_compiler",
    flag_values = {
        "@bazel_tools//tools/cpp:compiler": "mingw-gcc",
    },
    visibility = [":__subpackages__"],
)

# The C oracle target.  This is the reference implementation the Rust port is
# verified against, and it is what a Bazel consumer of `:z` or `:zlib` links --
# now and after the port, because Rust is out of Bazel scope here.
#
# The Rust equivalents of the artifacts produced by this target, libz.so and
# libz.a, are INTENDED to carry the same exported symbols and are built with
# `cargo build --release -p zlib-rs -p libz-rs-sys` and packaged by
# `make rust`.  Name the two packages explicitly: a bare `cargo build` at the
# workspace root also reaches crates/zlib-rs-differential, whose build script
# compiles the very C sources listed below.  Symbol parity against this target's
# output is the requirement, and `make rust-test` is what checks it with nm.  The
# facade carries the whole exported surface in Rust, so that check is runnable;
# run it before relying on parity, because no in-tree automation runs it.
cc_library(
    name = "z",
    srcs = [
        "adler32.c",
        "compress.c",
        "crc32.c",
        "deflate.c",
        "gzclose.c",
        "gzlib.c",
        "gzread.c",
        "gzwrite.c",
        "infback.c",
        "inffast.c",
        "inflate.c",
        "inftrees.c",
        "trees.c",
        "uncompr.c",
        "zutil.c",
        # Include the un-prefixed headers in srcs to work
        # around the fact that zlib isn't consistent in its
        # choice of <> or "" delimiter when including itself.
    ] + _ZLIB_HEADERS,
    hdrs = _ZLIB_PREFIXED_HEADERS,
    copts = select({
        ":mingw_gcc_compiler": [
            "-fpermissive",
        ],
        "@platforms//os:windows": [],
        "//conditions:default": [
            "-Wno-deprecated-non-prototype",
            "-Wno-unused-variable",
            "-Wno-implicit-function-declaration",
        ],
    }),
    includes = ["zlib/include/"],
    visibility = ["//visibility:public"],
)

alias(
    name = "zlib",
    actual = ":z",
    visibility = ["//visibility:public"],
)
