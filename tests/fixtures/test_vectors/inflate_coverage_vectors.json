{
  "metadata": {
    "source": "test/infcover.c",
    "description": "Hex-encoded DEFLATE bitstream fixtures for inflate coverage testing",
    "format": "Space-separated hex bytes as strings, parseable by h2b() equivalent"
  },
  "cover_support": [
    {
      "hex": "63 0",
      "description": "force window allocation",
      "step": 0,
      "window_bits": -15,
      "output_len": 1,
      "expected_return": "Z_OK"
    },
    {
      "hex": "63 18 5",
      "description": "force window replacement",
      "step": 0,
      "window_bits": -8,
      "output_len": 259,
      "expected_return": "Z_OK"
    },
    {
      "hex": "63 18 68 30 d0 0 0",
      "description": "force split window update",
      "step": 4,
      "window_bits": -8,
      "output_len": 259,
      "expected_return": "Z_OK"
    },
    {
      "hex": "3 0",
      "description": "use fixed blocks",
      "step": 0,
      "window_bits": -15,
      "output_len": 1,
      "expected_return": "Z_STREAM_END"
    },
    {
      "hex": "",
      "description": "bad window size",
      "step": 0,
      "window_bits": 1,
      "output_len": 0,
      "expected_return": "Z_STREAM_ERROR"
    }
  ],
  "cover_wrap": [
