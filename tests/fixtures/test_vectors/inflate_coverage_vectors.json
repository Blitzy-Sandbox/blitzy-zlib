  "cover_back": {
    "pull_data": [99, 0, 2, 0],
    "pull_data_hex": "63 00 02 00",
    "description": "Static data used by pull() callback for inflateBack tests",
    "tests": [
      {
        "description": "inflateBack Z_STREAM_END",
        "avail_in": 2,
        "next_in_hex": "03",
        "expected_return": "Z_STREAM_END"
      },
      {
        "description": "force output error",
        "avail_in": 3,
        "next_in_hex": "63 00",
        "expected_return": "Z_BUF_ERROR"
      },
      {
        "description": "force mode error",
        "expected_return": "Z_STREAM_ERROR"
      }
    ]
