# This Bazel module builds only the C reference implementation: the :z library
# and its :zlib alias in BUILD.bazel.  Those C sources are retained unmodified
# and act as the differential oracle for the memory-safe Rust reimplementation
# of this library.
#
# The Rust implementation is a Cargo workspace rooted at Cargo.toml, with members
# crates/zlib-rs, crates/libz-rs-sys and crates/zlib-rs-differential.  It is
# built with `cargo build --release -p zlib-rs -p libz-rs-sys` -- the two crates
# that ship, named explicitly so the build does not also select the differential
# harness, which compiles C from its build script -- and not with Bazel.  Rust is
# deliberately out of Bazel scope here, so no Rust ruleset is added to the
# bazel_dep list below.
#
# The Rust implementation is REQUIRED to export the same byte-compatible C ABI as
# the C one, which is why compatibility_level stays 1: this module keeps building
# and exporting the C library either way, so no Bazel consumer of it is affected
# by the port regardless of how that requirement is progressing.
module(
    name = "zlib",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.0.16")
bazel_dep(name = "rules_license", version = "1.0.0")
