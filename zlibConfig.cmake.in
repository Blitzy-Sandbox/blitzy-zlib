@PACKAGE_INIT@

# find_package(ZLIB CONFIG) defines two imported targets: ZLIB::ZLIB for the
# shared library and ZLIB::ZLIBSTATIC for the static one.  `shared' and `static'
# are this package's only components -- name one to get just that target, or
# request none and get both.
#
# Those two targets are the entire consumption interface, and it does not change
# with the implementation behind them.  zlib is built either from its C sources
# or, with -DZLIB_BUILD_RUST=ON, from the memory-safe Rust implementation in
# crates/libz-rs-sys; both install the same unmodified zlib.h and generated
# zconf.h, carry the SONAME libz.so.1, and export the same symbols at the same
# versions, because zlib.map is handed to the linker either way.  There is
# deliberately no `rust' component: which implementation was built is settled
# when zlib itself is configured and is not something a consumer selects or can
# observe.  Existing projects need no change and no recompilation.
#
# One thing the two implementations genuinely do not share is what STATIC linking
# requires beside the archive.  A C libz.a stands alone; a Rust one carries the
# Rust standard library's object code and needs the target-specific set that
# `rustc --print native-static-libs' names.  That difference is not left to the
# consumer to discover: when the Rust library was built, CMakeLists.txt probes
# the set at configure time and publishes it in the INTERFACE_LINK_LIBRARIES of
# the ZLIB::ZLIBSTATIC target that ZLIB-static.cmake defines, so the very same
# `target_link_libraries(app ZLIB::ZLIBSTATIC)' produces a complete link line
# under either implementation.  In C mode nothing extra is published, because
# nothing extra is needed.  Read ZLIB-static.cmake to see which case this
# installation is.

set(_ZLIB_supported_components "shared" "static")

if(ZLIB_FIND_COMPONENTS)
    foreach(_comp ${ZLIB_FIND_COMPONENTS})
        if(NOT _comp IN_LIST _ZLIB_supported_components)
            set(ZLIB_FOUND False)
            set(ZLIB_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
        endif(NOT _comp IN_LIST _ZLIB_supported_components)

        include("${CMAKE_CURRENT_LIST_DIR}/ZLIB-${_comp}.cmake")
    endforeach(_comp ${ZLIB_FIND_COMPONENTS})
else(ZLIB_FIND_COMPONENTS)
    foreach(_component_config IN LISTS _ZLIB_supported_components)
        include("${CMAKE_CURRENT_LIST_DIR}/ZLIB-${_component_config}.cmake")
    endforeach(_component_config IN LISTS _ZLIB_supported_components)
endif(ZLIB_FIND_COMPONENTS)

# THE STATIC ARCHIVE'S NATIVE RUNTIME DEPENDENCIES ARE PUBLISHED, AND NOT HERE.
#
# When the installed libz.a is the Rust one it does not stand alone: it carries the
# Rust standard library's own object code, whose undefined references reach into libc
# and its neighbours, and a static archive cannot record that the way a shared object
# records DT_NEEDED.  So the consumer has to be told, and it is -- through the
# INTERFACE_LINK_LIBRARIES of the ZLIB::ZLIBSTATIC target that ZLIB-static.cmake
# defines.  CMakeLists.txt attaches the probed set to the exported target before that
# file is generated, and asserts that the property it wrote is exactly the probed set.
#
# THIS FILE DELIBERATELY ADDS NOTHING TO IT.  An earlier revision appended the same
# list again here, on the reasoning that the export was generated from the C target
# and could not carry a Rust-specific interface; the export-time writer closed that,
# and with both in place a measured consumer received every `-l' flag TWICE.  Two
# writers for one property is the defect -- neither can see what the other did, and
# nothing can then assert the final set -- so there is exactly one, and it is the one
# that also owns the assertion.  Read ZLIB-static.cmake to see which case an
# installation is: in C mode the property is absent, because a C libz.a needs nothing
# beside it.
#
# The set itself is target-specific and derived at configure time by
# `rustc --crate-type staticlib --print native-static-libs' -- never hardcoded -- and
# it is the same set zlib.pc's private link line advertises to pkg-config consumers.
# Shared consumers need none of it: ZLIB::ZLIB resolves through the SONAME and its own
# DT_NEEDED.
