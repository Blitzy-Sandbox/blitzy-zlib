@PACKAGE_INIT@

# find_package(ZLIB CONFIG) defines two imported targets: ZLIB::ZLIB for the
# shared library and ZLIB::ZLIBSTATIC for the static one.  `shared' and `static'
# are this package's only components -- name one to get just that target, or
# request none and get both.
#
# Those two targets are the entire consumption interface, and it does not change
# with the implementation behind them.  zlib is built either from its C sources
# or, with -DZLIB_BUILD_RUST=ON, from the memory-safe Rust implementation in
# crates/libz-rs-sys; both install the same unmodified zlib.h and generated
# zconf.h, carry the SONAME libz.so.1, and export the same symbols at the same
# versions, because zlib.map is handed to the linker either way.  There is
# deliberately no `rust' component: which implementation was built is settled
# when zlib itself is configured and is not something a consumer selects or can
# observe.  Existing projects need no change and no recompilation.

set(_ZLIB_supported_components "shared" "static")

if(ZLIB_FIND_COMPONENTS)
    foreach(_comp ${ZLIB_FIND_COMPONENTS})
        if(NOT _comp IN_LIST _ZLIB_supported_components)
            set(ZLIB_FOUND False)
            set(ZLIB_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
        endif(NOT _comp IN_LIST _ZLIB_supported_components)

        include("${CMAKE_CURRENT_LIST_DIR}/ZLIB-${_comp}.cmake")
    endforeach(_comp ${ZLIB_FIND_COMPONENTS})
else(ZLIB_FIND_COMPONENTS)
    foreach(_component_config IN LISTS _ZLIB_supported_components)
        include("${CMAKE_CURRENT_LIST_DIR}/ZLIB-${_component_config}.cmake")
    endforeach(_component_config IN LISTS _ZLIB_supported_components)
endif(ZLIB_FIND_COMPONENTS)
