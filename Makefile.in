# Makefile for zlib
# Copyright (C) 1995-2026 Jean-loup Gailly, Mark Adler
# For conditions of distribution and use, see copyright notice in zlib.h

# To compile and test, type:
#    ./configure; make test
# Normally configure builds both a static and a shared library.
# If you want to build just a static library, use: ./configure --static

# To install /usr/local/lib/libz.* and /usr/local/include/zlib.h, type:
#    make install
# To install in $HOME instead of /usr/local, use:
#    make install prefix=$HOME

# To build the memory-safe Rust implementation of zlib together with the
# C-ABI library it exports, type:
#    make rust
# To run the Rust test suites and then relink the unmodified test/example.c,
# test/minigzip.c and test/infcover.c against that library instead of the C
# one, and compare its exported symbols with the C library's, type:
#    make rust-test
# To compare the exported symbols of that library against the C one, which
# is the gate that proves an already-linked consumer can bind to it, type:
#    make rust-symbols
# To emit the pkg-config descriptor for the staged library -- the C one plus the
# single Libs.private key a Rust static archive needs, derived for the target
# being built -- and then compile, link and run a C consumer from nothing but
# the flags pkg-config answers for it, type:
#    make rust-pc
# To regenerate the C header from the Rust facade with cbindgen and hold that
# artifact to the header gate -- an enumerated warning allowance, a standalone
# compile as C89, C99, C17 and C++17 with warnings as errors, and a comparison
# of its declared function set against zlib.h's in both directions -- type:
#    make rust-header
# To check the two shipped crates on the declared MSRV floor with warnings as
# errors -- the gate that catches a diagnostic only the floor compiler emits,
# which a stable-only check cannot see -- type:
#    make rust-msrv
# To remove everything those targets produced, type:
#    make rust-clean
# See the comment above the `rust-test' rule for what those checks do and do
# not establish; several verification gates named in the port's plan are not
# among them.
# All seven targets are standalone on purpose: no C target depends on
# them, because the C library is the reference the Rust port is diffed
# against and has to stay buildable and green on its own.  Among themselves two
# do depend on `rust', which stages the library they read -- `rust-test' and
# `rust-pc' -- and `rust-test' depends on `rust-pc' as well, so a green run of
# it covers the packaging descriptor too.  When no cargo is available configure
# leaves CARGO empty; `rust', `rust-test' and `rust-msrv' then refuse and exit
# nonzero, naming the remedy, because an explicit request to build, test or
# MSRV-check the Rust library must not be reported as done when it cannot be
# honoured.  `rust-header' refuses on the same principle, and needs two
# things `rust' does not: cbindgen, and a cargo reachable on PATH -- cbindgen
# resolves `--crate' through `cargo metadata', so a $(CARGO) that names an
# executable outside PATH is not enough for it.  `rust-clean' still succeeds,
# because removing the staged library needs no cargo.

#
# To select the alternative checksum backends, set ZLIB_RS_SIMD in the
# environment (or on the command line) when running either Rust target:
#    ZLIB_RS_SIMD=1 make rust
# 1 adds the `simd' Cargo feature to every package the target builds, 0 (or
# leaving it unset) builds the scalar backends, and anything else is an
# error.  It has to be resolved here rather than inside a build script,
# because Cargo settles the feature graph before any build script runs.
#
# The feature name says SIMD; what it selects is portable integer code written
# in a shape LLVM can autovectorise at opt-level 3, with no architecture
# intrinsic in it -- that is what lets the safe core keep forbid(unsafe_code) --
# so whether vector instructions are emitted is a property of the compiler and
# the target rather than something this option guarantees.  Nor is either backend
# chosen by probing the CPU: the CRC-32 one performs no run-time feature test at
# all, and the Adler-32 one consults an is_supported() that is a throughput hint,
# never a correctness gate.  What IS guaranteed is the answer.  The feature is
# confined to CRC-32 and Adler-32 and is output neutral: a checksum yields one
# scalar however it is computed, so it changes speed only, never a single emitted
# byte.

CC=cc
GCOV=GCOV
LLVM_GCOV_FLAG=LLMV_GCOV_FLAG

CFLAGS=-O
#CFLAGS=-O -DMAX_WBITS=14 -DMAX_MEM_LEVEL=7
#CFLAGS=-g -DZLIB_DEBUG
#CFLAGS=-O3 -Wall -Wwrite-strings -Wpointer-arith -Wconversion \
#           -Wstrict-prototypes -Wmissing-prototypes

SFLAGS=-O
LDFLAGS=
TEST_LIBS=-L. libz.a
LDSHARED=$(CC)
CPP=$(CC) -E
VGFMAFLAG=

STATICLIB=libz.a
SHAREDLIB=libz.so
SHAREDLIBV=libz.so.1.3.2.1
SHAREDLIBM=libz.so.1
LIBS=$(STATICLIB) $(SHAREDLIBV)
# configure substitutes SHAREDLIB, SHAREDLIBV and SHAREDLIBM from the
# ZLIB_VERSION it reads out of zlib.h, so the values above are only the
# defaults used when configure has not run.  SHAREDLIBV's default is stale --
# zlib.h now says 1.3.2.1-motley, making the configured name
# libz.so.1.3.2.1-motley -- and it is left as it is so that the C build's
# unconfigured output keeps the name it has always had.  The Rust packaging
# step in the `rust' target therefore does not trust it for the version: it
# reads ZLIB_VERSION from $(SRCDIR)zlib.h itself, because a drop-in
# replacement whose file name disagrees with the version it reports is not a
# drop-in replacement.  SHAREDLIBV is still read there for the one thing it
# alone records: emptied by configure --static, it means no shared library
# was wanted.

AR=ar
ARFLAGS=rc
RANLIB=ranlib
LDCONFIG=ldconfig
LDSHAREDLIBC=-lc
TAR=tar
SHELL=/bin/sh
EXE=

# Rust workspace.  The variables below drive the `rust', `rust-pc', `rust-test',
# `rust-symbols' and `rust-clean' targets; no C target reads any of them.
#
# Only CARGO is substituted by configure, through a
# /^CARGO *=/s#=.*#=$CARGO# rule, which is why it has to stay a plain
# NAME=value line starting in column 0.  The rest are ordinary make
# variables, need no configure counterpart, and can be overridden on the
# command line, for example
#    make rust CARGO_BUILD_FLAGS='--release --locked'
#    make rust RUSTNM=aarch64-linux-gnu-nm RUSTOBJCOPY=aarch64-linux-gnu-objcopy
#
#   CARGO              The cargo executable, or EMPTY when configure found
#                      no Rust toolchain.  Empty makes every Rust target except
#                      `rust-clean' REFUSE, naming the remedy and exiting
#                      nonzero: an explicit request to build, test or check the
#                      Rust library must not be reported as done when it cannot
#                      be honoured.  No C target reads this variable, so a
#                      machine without cargo still builds and tests the C
#                      library exactly as before.
#   CARGO_BUILD_FLAGS  Flags for `cargo build'.  These pick the profile, and
#                      RUSTDIR is derived from them, so the two cannot drift.
#   CARGO_TEST_FLAGS   Flags for `cargo test'.
#   CARGO_MSRV_FLAGS   Flags for the `rust-msrv' check.  Scoped to the two
#                      SHIPPED crates on purpose -- see the comment above that
#                      rule for why --workspace cannot resolve at the floor.
#   RUSTMSRV           The MSRV floor toolchain `rust-msrv' checks against.
#                      MUST equal `rust-version' in the root Cargo.toml, which
#                      both shipped crates inherit.  clippy.toml declares no
#                      `msrv' key -- deliberately, so that clippy reads each
#                      package's own `rust-version' -- so there is no third
#                      value to keep in step.
#   RUSTMSRVFLAGS      RUSTFLAGS for that check; `-D warnings' is the point of
#                      the target.
#   RUSTTARGETDIR      Cargo's target directory, relative to the build
#                      directory.  Exported as CARGO_TARGET_DIR so that an
#                      out-of-source build keeps its artifacts out of
#                      SRCDIR.  MUST be a relative path strictly beneath the
#                      build directory -- see RUSTPATHGUARD below, which
#                      refuses anything else before a recursive delete can
#                      reach it.
#   RUSTDIR            Where cargo writes $(SHAREDLIB) and $(STATICLIB).
#                      EMPTY by default, which means "derive it": the `rust'
#                      recipe reads --release, --profile and --target out of
#                      $(CARGO_BUILD_FLAGS) and builds
#                      $(RUSTTARGETDIR)[/<triple>]/<profile> from them, so a
#                      profile or cross-target change needs no second edit.
#                      Set it explicitly to override that.
#   RUSTLIBDIR         Packaging directory for the drop-in library: a real
#                      $(SHAREDLIBV), relinked from $(STATICLIB) through
#                      $(LDSHARED) so that it carries the same SONAME and the
#                      same $(SRCDIR)zlib.map version script as the C build,
#                      with $(SHAREDLIBM) and $(SHAREDLIB) symlinked to it --
#                      the same topology the $(SHAREDLIBV) rule gives the C
#                      library -- plus the relinked C drivers and the symbol
#                      lists the parity diff compares.  It is deliberately
#                      not $(RUSTDIR), because cargo puts that directory
#                      first on LD_LIBRARY_PATH when it runs tests and a
#                      $(SHAREDLIBM) sitting there would be loaded by
#                      unrelated processes; and deliberately not the build
#                      directory, where libz.* belongs to the C build and
#                      testshared searches for it.
#   RUSTNM             Symbol reader for the ABI parity gate in `rust'.
#   RUSTOBJCOPY        Object editor the same gate uses to give the
#                      compiler-runtime globals a Rust static library carries
#                      local binding, so that they cannot reach the shared
#                      library's dynamic symbol table.  configure computes an
#                      NM of its own but has no sed rule for it, so these two
#                      are named apart from it to make plain that they are
#                      not substituted; a cross build overrides them on the
#                      command line as shown above.
#
#   RUSTSHIMDIR        The C translation units the Rust library contains: the
#                      varargs shim that defines gzprintf and gzvprintf, and the
#                      inftrees shim that defines inflate_table with its own
#                      `codetype' prototype.  Stable Rust can declare none of
#                      the three.  THIS RECIPE DOES NOT COMPILE THEM: cargo does,
#                      in crates/libz-rs-sys/build.rs, and archives them into the
#                      $(STATICLIB) it produces, so the relink below has one
#                      complete archive to work from rather than an archive plus
#                      an object this file compiled separately.  Named here only
#                      for the diagnostics.
#   RUSTSHIMSYMS       The symbols those units define.  Checked for in the
#                      staged archive before anything is relinked, so a cargo
#                      build that ran without a C compiler is caught here rather
#                      than in some consumer's link.
#   RUSTSHIMFLAGS      Extra C flags exported to that cargo build as $$CFLAGS,
#                      on top of $(SFLAGS).
#   ZLIBREF            The C shared library `rust-symbols' compares against.
#                      Defaults to the one this build produces.
#
#   RUSTCOREFEATURES   Cargo features for crates/zlib-rs, and
#   RUSTSYSFEATURES    Cargo features for crates/libz-rs-sys, in the packaging
#                      build.  THIS TARGET OWNS FEATURE SELECTION, which is why
#                      the two lists are variables and why a `--features' or
#                      `--no-default-features' in $(CARGO_BUILD_FLAGS) is
#                      refused: the archive cargo produces contains
#                      $(RUSTSHIMDIR)'s objects, and those units call Rust
#                      adapters that exist only behind `libz-compat' and `gz'.
#                      A build that dropped either feature would produce a
#                      library with no gzprintf, no gzvprintf and no
#                      inflate_table, and it would produce it silently.  `gz' is
#                      therefore NAMED here rather than relied on as a default --
#                      a default is exactly what `--no-default-features' removes.
#   RUSTZVERCMD        The one authoritative reading of ZLIB_VERSION, used by
#                      every recipe that needs the versioned library name.  Its
#                      pattern matches `.*define ZLIB_VERSION' rather than
#                      `^#define': make treats an unescaped `#' in a VARIABLE
#                      ASSIGNMENT as the start of a comment, so the anchored
#                      spelling -- which is correct inside a recipe line, and is
#                      what `rust-test' used before this variable existed --
#                      truncates the value here to `sed -n 's/^' and the recipe
#                      dies with "Unterminated quoted string" (measured).
#                      Identical in form to what configure L56 does with sed, so
#                      the Rust and C names cannot disagree; and used INSTEAD of
#                      $(SHAREDLIBV) for the version, because that variable's
#                      unconfigured default is deliberately stale (see the note
#                      above AR).  $(SHAREDLIBV) is still read for the one thing
#                      it alone records: emptied by `configure --static', it
#                      means no shared library was wanted.
#   RUSTLDSHARED       The link command that produces the staged shared object.
#                      Defaults to $(LDSHARED) so that whatever configure baked
#                      in applies unchanged.  The next four variables supply
#                      what $(LDSHARED) does NOT already carry -- which is
#                      everything, on the unconfigured path, where LDSHARED is
#                      just $(CC).
#   RUSTSHAREDFLAG     Added when the link command has no -shared/-dynamiclib.
#   RUSTSONAMEFLAG     Prefix for the soname argument, added when the link
#                      command carries neither -soname nor -install_name.  The
#                      Mach-O spelling is a command-line override:
#                         make rust RUSTSONAMEFLAG=-Wl,-install_name,
#   RUSTVERSIONSCRIPT  The version script applied to the staged library, and
#   RUSTVERSIONSCRIPTFLAG
#                      the flag that applies it.  Setting EITHER to empty is the
#                      documented way to say "this format has no version-script
#                      concept" (Mach-O, PE).  That is an explicit operator
#                      decision and it is printed; what is NOT allowed any more
#                      is discovering it by accident, staging an unversioned
#                      library and reporting success -- the state this file used
#                      to reach whenever $(LDSHARED) happened not to mention a
#                      version script.
#   RUSTWINONLY        Names zlib.h declares only under _WIN32, excluded from
#                      the expected export set off Windows.  Currently gzopen_w
#                      (zlib.h L2042).
#   RUSTRUNTIMESYMS    Symbols the Rust language runtime contributes to
#                      $(STATICLIB) that zlib.map cannot hide, excluded from the
#                      export comparison.  Currently rust_eh_personality only:
#                      an enumerated name rather than a pattern, so a second
#                      leaked symbol cannot hide behind it.
#   RUSTCBINDGEN       The header generator `rust-header' runs.  Pinned to
#                      cbindgen 0.29.4 by the port's plan; every key in
#                      $(SRCDIR)cbindgen.toml was checked against that
#                      version's Config, and 0.29.x rejects an unknown key
#                      outright, so a newer cbindgen is a deliberate change
#                      and not a drop-in.  Install it with
#                      `cargo install cbindgen --locked --version 0.29.4'.
#   RUSTHEADER         Where the generated artifact is written.  The build
#                      directory root, matching the path .gitignore carries an
#                      anchored rule for and the one `rust-clean' removes.  It
#                      is NEVER installed and never put on an include path: its
#                      guard is ZLIB_H, so a build that found it first would
#                      compile against a scratch file instead of the real
#                      header.  The compile legs below therefore name it as a
#                      file operand, never through -I.
#   RUSTHEADERCXX      The C++ compiler for the C++ leg.  $(CC) drives the C
#                      legs; there is no CXX in this file because no C target
#                      needs one.
#   RUSTHEADERCSTDS    The C dialects the artifact must compile as, warnings
#                      fatal.  C89 is in the list because the header this one
#                      is diffed against has compiled as C89 since 1995.  Each
#                      dialect is probed on an empty translation unit first, so
#                      that a compiler which does not know a -std value is
#                      reported as exactly that and cannot be mistaken for a
#                      bad header -- and cannot silently reduce the gate
#                      either, since the probe result is printed per dialect.
#   RUSTHEADERCXXSTDS  The C++ dialects, same treatment.  A C++ leg is not
#                      optional: cbindgen's `cpp_compat' emits the
#                      `extern "C"' bracket that every C++ consumer of zlib.h
#                      relies on, and nothing else here compiles it.
#   RUSTHEADERC89FLAGS Dialect-specific relaxations for the C89 leg, and the
#                      only ones anywhere in this gate.  cbindgen hard-codes
#                      `#endif  // __cplusplus' where zlib.h writes a bare
#                      `#endif'; trailing tokens on an #endif are a C89
#                      constraint violation, so -std=c89 needs
#                      -Wno-endif-labels.  This is decision D9 in
#                      $(SRCDIR)cbindgen.toml -- an enumerated property of the
#                      GENERATOR, not a divergence in the contract, and it does
#                      not apply from C99 on, where `//' is a comment.  The
#                      immutable zlib.h is what has to stay strictly C89 and
#                      .github/workflows/c-std.yml is what holds it to that.
#   RUSTHEADERDEFS     The declared configuration the artifact is generated,
#                      compiled and parsed under.  cbindgen maps the facade's
#                      Cargo features onto these macros ([defines] in
#                      cbindgen.toml), so without them every conditional item
#                      -- which is all of them -- is preprocessed away and the
#                      gate would compare two empty sets and pass.
#   RUSTHEADERTARGETS  Target-conditional macros the generated header is swept
#                      under, in addition to the host configuration.  cbindgen
#                      renders a cfg(windows) item inside `#if defined(_WIN32)'
#                      rather than omitting it, so the artifact carries
#                      declarations -- gzopen_w (zlib.h L2042) and the _WIN32
#                      arm of the portability typedefs -- that the plain sweep
#                      preprocesses away and therefore never compiles.  Sweeping
#                      with -D_WIN32 as well is what puts those under a compiler.
#                      MEASURED: a `typedef uint16_t wchar_t;' emitted inside
#                      that guard compiles clean in every dialect without the
#                      variant and fails as both C and C++ with it, so without
#                      this the one defect the wchar_t exclusion in
#                      cbindgen.toml exists to prevent would be invisible here.
#                      Set it empty to sweep the host configuration only.
#   RUSTPUBLICFNS      How many functions $(SRCDIR)zlib.h is expected to declare
#                      for a non-Windows target: 95.  The symbol comparison is
#                      already an exact two-way set diff, but both of its sides
#                      are DERIVED -- want from the header, have from the
#                      artifact -- so a change to the header moves both sides
#                      together and passes.  zlib.h is immutable, so asserting
#                      the count is what pins the contract itself rather than
#                      the agreement between two things derived from it.  Not
#                      asserted when $(EXE) is set, because gzopen_w is exported
#                      there and the count is 96.  Set it empty to skip.
#   RUSTVERNODES       How many symbol version nodes $(SRCDIR)zlib.map declares:
#                      16.  Same reasoning as RUSTPUBLICFNS -- the diff above it
#                      compares the map against the artifact, and this compares
#                      the map against the frozen contract.  A consumer already
#                      linked against a node this library stops defining fails
#                      to bind at load time, which no set diff between two
#                      derived sides would reveal.  Set it empty to skip.
#   RUSTHEADERWARNOK   Extended regex matching the cbindgen notices that are an
#                      enumerated, justified allowance.  It admits three, all of
#                      the form "Can't find <type>".
#
#                      Two are for the case where cbindgen looks for a
#                      user-defined item named c_ulong or usize while
#                      resolving `pub type uLong = c_ulong' and `pub type
#                      z_size_t = usize', finds neither because both are compiler
#                      primitives, and renders both correctly anyway.  With
#                      `usize_is_size_t = true' in cbindgen.toml the current tree
#                      does not produce them -- the header does carry
#                      `typedef unsigned long uLong;' and `typedef size_t
#                      z_size_t;' -- so the allowance is retained for a
#                      configuration that resolves them differently rather than
#                      because anything relies on it.
#
#                      The third is wchar_t, and it is REQUIRED rather than
#                      tolerated.  cbindgen.toml excludes that item deliberately:
#                      wchar_t is a BUILT-IN TYPE in C++, so emitting `typedef
#                      uint16_t wchar_t;' -- which cbindgen does for the
#                      #[cfg(windows)] alias gzopen_w needs -- makes the artifact
#                      fail to compile as C++ under _WIN32.  zlib.h L2042 defines
#                      no such typedef either: it names the type and lets the
#                      platform supply it, which for C is the stddef.h already in
#                      `sys_includes'.  So the notice is cbindgen reporting that it
#                      resolved the name to nothing, having been told to, while
#                      still rendering `const wchar_t *' correctly -- verified in
#                      the generated artifact.  ANY other line on
#                      cbindgen's stderr fails the target: the 269 warnings this
#                      gate started from were all real -- items cbindgen could
#                      not resolve and therefore could not have compared -- and
#                      drowning informative notices in them is how that stayed
#                      unnoticed.  Widen this regex only with the same kind of
#                      written justification.
#   RUSTMACROFN        (shared with the symbol gate below.)  The zlib.h names
#                      that are declared with ZEXTERN and then
#                      shadowed by a function-like macro of the same name
#                      (zlib.h L1932-L1944, and the z_-prefixed spellings of
#                      the same five at L1917-L1930).  Each expands to the
#                      matching *_ entry point, so none of them is a symbol in
#                      any library, C or Rust, and all five are removed from
#                      the reference set before it is compared.  This is an
#                      enumerated list and not `every function-like macro in
#                      zlib.h', because gzgetc is BOTH a macro (L1967-L1968)
#                      and a real export -- measured: it is in the C library's
#                      dynamic table -- so a rule that filtered macros
#                      wholesale would drop a name the gate has to require.
#   RUSTHEADERNOGEN    Names zlib.h declares that the generated side is allowed
#                      not to declare, each for a stated reason.  Exactly one
#                      today: gzopen_w is _WIN32-only (zlib.h L2042) and cannot
#                      appear when generating for this host.
#
#                      gzprintf and gzvprintf were listed here while nothing
#                      rendered them -- one is C variadic and the other takes a
#                      va_list, so stable Rust can define neither and they live
#                      in $(RUSTSHIMDIR).  They are no longer an allowance: decision
#                      D11 in $(SRCDIR)cbindgen.toml annotates the shim's two
#                      declarations, so the generated header carries both
#                      prototypes and this target REQUIRES them, like any other
#                      contract name.  That they are also exported is what `rust'
#                      and `rust-test' check with nm, which this target cannot,
#                      because it never opens a library.
#   RUSTHEADEREXTRAOK  Names the generated side is allowed to declare that
#                      zlib.h does not.  EMPTY today, and that is the state to
#                      keep it in.  inflate_table was the single entry while the
#                      Rust side exported that name; it is now defined in
#                      $(RUSTSHIMDIR)/inftrees_shim.c with inftrees.h's own
#                      `codetype' prototype, so cbindgen never sees it and the
#                      generated header cannot disagree with the declaration
#                      test/infcover.c compiles against.  Anything appearing here
#                      is an internal escaping into a file that looks exactly like
#                      the public contract, which is the failure this list exists
#                      to catch.
#   RUSTHEADERSCRATCH  The working files the gate writes beside the artifact:
#                      cbindgen's stderr, the last compiler log, the empty
#                      translation unit each dialect is probed with, and the two
#                      sorted name lists the comparison reads.  A passing run
#                      removes them and leaves only $(RUSTHEADER); a FAILING run
#                      deliberately leaves them in place, because the compiler
#                      log and the two name lists are the evidence.
#                      `rust-clean' removes them, and .gitignore carries an
#                      anchored rule for each.
#   RUSTC              The Rust compiler `rust-pc' asks for the target's native
#                      static library list.  Only that: nothing here compiles
#                      Rust code with it, cargo does that.  It is a separate
#                      variable from $(CARGO) because a cross build can name a
#                      cargo wrapper while still wanting the plain rustc, and
#                      because the probe has to be answerable when the list is
#                      the only thing wanted.
#   RUSTPKGCONFIG      The pkg-config implementation the static-consumer gate in
#                      `rust-pc' drives.  pkgconf answers the same options and
#                      works unchanged.  When it is absent the gate says so and
#                      skips the link leg; the content checks on the generated
#                      descriptor do not need it and always run.
#   RUSTPC             The pkg-config descriptor `rust-pc' generates for the
#                      STAGED RUST LIBRARY, in $(RUSTLIBDIR) beside the library
#                      it describes.  It is named zlib.pc because that is the
#                      name `pkg-config zlib' looks for, and it lives in the
#                      packaging directory rather than the build root so that it
#                      cannot be confused with -- or overwrite -- the
#                      configure-generated zlib.pc, which describes the C
#                      library and must keep advertising no private libraries at
#                      all.  A packager installing the staged Rust library
#                      installs THIS file into $(pkgconfigdir) in place of that
#                      one; `rust-pc' prints the copy command it should use.
#   RUSTPCPRIVATE      The private library list to advertise, stated rather than
#                      probed.  Empty by default, which means `rust-pc' derives
#                      it from $(RUSTC) for the target being built -- the list
#                      is target-specific and a literal would be wrong on the
#                      next target along.  Set it when rustc cannot be run for
#                      the target, or to pin a known-good list:
#                          make rust-pc RUSTPCPRIVATE='-lm -lpthread -lc'
#   RUSTPCGATE         Where the static-consumer gate builds its consumer.  A
#                      directory holding the staged archive, the two headers and
#                      a copy of $(RUSTPC) rewritten to point at itself, so that
#                      -lz can only resolve to the archive under test and never
#                      to a system libz.  Inside $(RUSTLIBDIR), so `rust-clean'
#                      removes it with everything else staged there.
CARGO=cargo
CARGO_BUILD_FLAGS=--locked --release
CARGO_TEST_FLAGS=--locked --workspace --release
CARGO_MSRV_FLAGS=--locked -p zlib-rs -p libz-rs-sys --all-features --all-targets
CARGO_MSRV_WS_FLAGS=--locked --workspace --all-targets
RUSTMSRV=1.80
RUSTMSRVFLAGS=-D warnings
RUSTTARGETDIR=target
RUSTDIR=
RUSTLIBDIR=$(RUSTTARGETDIR)/dropin
RUSTNM=nm
RUSTOBJCOPY=objcopy
# rustc is the only thing that knows which native libraries a Rust staticlib has
# to be linked against, and the set is target-specific.  The `rust' target asks
# it and reports the answer beside the staged libz.a, because zlib.pc cannot: it
# is written by configure, which runs before anyone decides whether to build the
# Rust library at all.  Overridable for a cross build, and a probe that cannot
# run is reported rather than fatal -- the archive is already staged and correct
# by then, and only the advice would be missing.
RUSTC=rustc
RUSTSHIMDIR=$(SRCDIR)crates/libz-rs-sys/csrc
RUSTSHIMSYMS= gzprintf gzvprintf inflate_table
RUSTSHIMFLAGS=-fPIC -DPIC
ZLIBREF=$(SHAREDLIBV)
RUSTCOREFEATURES=
RUSTSYSFEATURES=libz-compat,gz
RUSTZVERCMD=sed -n 's/^.*define ZLIB_VERSION "\(.*\)".*$$/\1/p' $(SRCDIR)zlib.h
RUSTLDSHARED=$(LDSHARED)
RUSTSHAREDFLAG=-shared
RUSTSONAMEFLAG=-Wl,-soname,
RUSTVERSIONSCRIPT=$(SRCDIR)zlib.map
RUSTVERSIONSCRIPTFLAG=-Wl,--version-script=
RUSTWINONLY=gzopen_w
RUSTMACROFN=deflateInit deflateInit2 inflateInit inflateInit2 inflateBackInit
RUSTRUNTIMESYMS=rust_eh_personality
RUSTCBINDGEN=cbindgen
RUSTHEADER=generated_zlib.h
RUSTHEADERCXX=g++
RUSTHEADERCSTDS=c89 c99 c17
RUSTHEADERCXXSTDS=c++17
RUSTHEADERC89FLAGS=-Wno-endif-labels
RUSTHEADERDEFS=-DZLIB_RS_LIBZ_COMPAT -DZLIB_RS_GZ
RUSTHEADERTARGETS=_WIN32
RUSTPUBLICFNS=95
RUSTVERNODES=16
RUSTHEADERWARNOK=Can.t find (c_ulong|usize|wchar_t)\.
RUSTHEADERNOGEN=$(RUSTWINONLY)
RUSTHEADEREXTRAOK=
RUSTHEADERSCRATCH=$(RUSTHEADER).warn $(RUSTHEADER).log $(RUSTHEADER).probe.c \
	$(RUSTHEADER).ref $(RUSTHEADER).gen
RUSTC=rustc
RUSTPKGCONFIG=pkg-config
RUSTPC=$(RUSTLIBDIR)/zlib.pc
RUSTPCPRIVATE=
RUSTPCGATE=$(RUSTLIBDIR)/pc-gate

# The variadic ABI boundary.  `gzprintf' is variadic and `gzvprintf' takes a
# va_list, and stable Rust can define neither -- `c_variadic' and
# `core::ffi::VaList' are both unstable, and guessing a va_list layout is
# ABI-invalid across the Tier-1 targets.  So those two exports live in one C
# translation unit that owns nothing but va_start/va_end and vsnprintf; every
# guard, the overflow sentinel and all the accounting are in safe Rust, in
# crates/zlib-rs/src/gz/printf.rs, which carries the whole contract.
#
# Cargo does NOT compile it: crates/libz-rs-sys has no [build-dependencies] and
# `cargo build --release' must work with no C compiler present.  Compiling it and
# getting it into both libraries is this file's job, which is the right place
# because this is also where zlib.map is applied.
# The GNU ld spellings for "take every member of this archive, including the
# ones nothing references yet".  They are separate variables so that a platform
# with a different linker can override them -- Mach-O's ld wants `-all_load' and
# no closing flag:
#    make rust RUSTWHOLEARCHIVE=-all_load RUSTNOWHOLEARCHIVE=
# The Rust staticlib is the only source of the port's exported symbols, and a
# shared library links nothing from an archive unless something asks for it, so
# without this the relinked library would be empty.
RUSTWHOLEARCHIVE=-Wl,--whole-archive
RUSTNOWHOLEARCHIVE=-Wl,--no-whole-archive

# The containment guard for the two directory variables that reach a recursive
# delete.  RUSTTARGETDIR and RUSTLIBDIR are ordinary make variables and may be
# overridden on the command line or from the environment, so an invocation such
# as `make rust-clean RUSTTARGETDIR=..' or `RUSTLIBDIR=$HOME make rust' would
# otherwise hand an arbitrary path to `rm -rf' with the build user's
# permissions.  Every recipe below that removes, creates or writes under either
# variable runs this first, and every operand in those recipes is quoted and
# introduced with `--' so that a leading dash or an embedded space cannot be
# read as an option or as a second word.
#
# The check is deliberately in three parts, and STRICTLY BENEATH is what it
# enforces -- the build directory itself is refused, because these recipes remove
# what they are given and the build directory is not theirs to remove.
#
#   1. A LEXICAL pass rejects the forms that are wrong regardless of what is on
#      disk: empty, absolute, tilde-prefixed, `.', `..', `./', `.//...', `./.',
#      anything containing a `..' path component, and anything outside a
#      conservative character set (which also removes every shell-metacharacter
#      and whitespace hazard).  The trailing-slash and `./' spellings are named
#      individually because they all canonicalise to the build root while
#      matching none of `.' or `..': rejecting only the literal `.' left
#      `RUSTLIBDIR=./' accepted, which is the hole this pass closes.
#   2. A CANONICALISING pass walks up to the nearest existing ancestor, resolves
#      it with `cd -P' and `pwd -P' so that a symlinked component cannot smuggle
#      the path elsewhere, and requires the result to be the build directory or
#      something beneath it.  It cannot decide the root question by itself: the
#      normal, legitimate `RUSTTARGETDIR=target' before `target' exists resolves
#      its nearest existing ancestor to the build directory too.
#   3. An IDENTITY pass therefore resolves the path ITSELF whenever it already
#      exists and refuses equality with the build root, which is what catches a
#      spelling that reaches the root through a symlink or through components
#      this file cannot enumerate.  A path that does not exist cannot be the
#      root, because pass 1 has already removed every spelling of the root that
#      names nothing new, and the basename is additionally required not to be
#      `.' or `..'.
#
# No pass alone is sufficient: the first cannot see a symlink, the second cannot
# judge a path whose ancestors do not exist yet, and the third cannot judge a
# path that is not there.
RUSTPATHGUARD = \
	zrs_reject() { \
	  echo "$$1" >&2; \
	  echo "	*** refusing to continue ***" >&2; \
	  exit 1; \
	}; \
	zrs_guard_dir() { \
	  zrs_v=$$1; zrs_n=$$2; zrs_root=`pwd -P`; \
	  case "$$zrs_v" in \
	    "") zrs_reject "$$zrs_n is empty" ;; \
	    /*) zrs_reject "$$zrs_n=$$zrs_v is an absolute path; it must be relative to the build directory" ;; \
	    "~"*) zrs_reject "$$zrs_n=$$zrs_v starts with a tilde" ;; \
	    . | .. | ./ | ../ | ./. | .//*) zrs_reject "$$zrs_n=$$zrs_v names the build directory or its parent" ;; \
	    ../* | */.. | */../*) zrs_reject "$$zrs_n=$$zrs_v contains a .. component" ;; \
	    *[!A-Za-z0-9._/+-]*) zrs_reject "$$zrs_n=$$zrs_v contains a character outside A-Za-z0-9._+-/" ;; \
	  esac; \
	  zrs_p=$$zrs_v; \
	  while test "$$zrs_p" != "." && test ! -d "$$zrs_p"; do \
	    zrs_p=`dirname -- "$$zrs_p"`; \
	  done; \
	  zrs_abs=`cd -P -- "$$zrs_p" 2>/dev/null && pwd -P` || \
	    zrs_reject "$$zrs_n=$$zrs_v: could not resolve $$zrs_p"; \
	  case "$$zrs_abs" in \
	    "$$zrs_root" | "$$zrs_root"/*) ;; \
	    *) zrs_reject "$$zrs_n=$$zrs_v resolves to $$zrs_abs, outside the build directory $$zrs_root" ;; \
	  esac; \
	  zrs_leaf=`basename -- "$$zrs_v"`; \
	  case "$$zrs_leaf" in \
	    . | ..) zrs_reject "$$zrs_n=$$zrs_v ends in a $$zrs_leaf component, so it names a directory it does not spell" ;; \
	  esac; \
	  if test -d "$$zrs_v"; then \
	    zrs_full=`cd -P -- "$$zrs_v" 2>/dev/null && pwd -P` || \
	      zrs_reject "$$zrs_n=$$zrs_v: could not resolve it"; \
	    test "$$zrs_full" != "$$zrs_root" || \
	      zrs_reject "$$zrs_n=$$zrs_v resolves to the build directory $$zrs_root ITSELF, not to something beneath it, and this target creates and REMOVES what it names"; \
	  fi; \
	}; \
	zrs_guard_dir "$(RUSTTARGETDIR)" RUSTTARGETDIR; \
	zrs_guard_dir "$(RUSTLIBDIR)" RUSTLIBDIR

prefix = /usr/local
exec_prefix = ${prefix}
libdir = ${exec_prefix}/lib
sharedlibdir = ${libdir}
includedir = ${prefix}/include
mandir = ${prefix}/share/man
man3dir = ${mandir}/man3
pkgconfigdir = ${libdir}/pkgconfig
SRCDIR=
ZINC=
ZINCOUT=-I.

OBJZ = adler32.o crc32.o deflate.o infback.o inffast.o inflate.o inftrees.o trees.o zutil.o
OBJG = compress.o uncompr.o gzclose.o gzlib.o gzread.o gzwrite.o
OBJC = $(OBJZ) $(OBJG)

PIC_OBJZ = adler32.lo crc32.lo deflate.lo infback.lo inffast.lo inflate.lo inftrees.lo trees.lo zutil.lo
PIC_OBJG = compress.lo uncompr.lo gzclose.lo gzlib.lo gzread.lo gzwrite.lo
PIC_OBJC = $(PIC_OBJZ) $(PIC_OBJG)

# to use the asm code: make OBJA=match.o, PIC_OBJA=match.lo
OBJA =
PIC_OBJA =

OBJS = $(OBJC) $(OBJA)

PIC_OBJS = $(PIC_OBJC) $(PIC_OBJA)

all: static shared

static: example$(EXE) minigzip$(EXE)

shared: examplesh$(EXE) minigzipsh$(EXE)

all64: example64$(EXE) minigzip64$(EXE)

check: test

test: all teststatic testshared

teststatic: static
	@TMPST=tmpst_$$; \
	if echo hello world | ${QEMU_RUN} ./minigzip | ${QEMU_RUN} ./minigzip -d && ${QEMU_RUN} ./example $$TMPST ; then \
	  echo '		*** zlib test OK ***'; \
	else \
	  echo '		*** zlib test FAILED ***'; false; \
	fi
	@rm -f tmpst_$$

testshared: shared
	@LD_LIBRARY_PATH=`pwd`:$(LD_LIBRARY_PATH) ; export LD_LIBRARY_PATH; \
	LD_LIBRARYN32_PATH=`pwd`:$(LD_LIBRARYN32_PATH) ; export LD_LIBRARYN32_PATH; \
	DYLD_LIBRARY_PATH=`pwd`:$(DYLD_LIBRARY_PATH) ; export DYLD_LIBRARY_PATH; \
	SHLIB_PATH=`pwd`:$(SHLIB_PATH) ; export SHLIB_PATH; \
	TMPSH=tmpsh_$$; \
	if echo hello world | ${QEMU_RUN} ./minigzipsh | ${QEMU_RUN} ./minigzipsh -d && ${QEMU_RUN} ./examplesh $$TMPSH; then \
	  echo '		*** zlib shared test OK ***'; \
	else \
	  echo '		*** zlib shared test FAILED ***'; false; \
	fi
	@rm -f tmpsh_$$

test64: all64
	@TMP64=tmp64_$$; \
	if echo hello world | ${QEMU_RUN} ./minigzip64 | ${QEMU_RUN} ./minigzip64 -d && ${QEMU_RUN} ./example64 $$TMP64; then \
	  echo '		*** zlib 64-bit test OK ***'; \
	else \
	  echo '		*** zlib 64-bit test FAILED ***'; false; \
	fi
	@rm -f tmp64_$$

infcover.o: $(SRCDIR)test/infcover.c $(SRCDIR)zlib.h zconf.h $(SRCDIR)inflate.h $(SRCDIR)inftrees.h
	$(CC) $(CFLAGS) $(ZINCOUT) -c -coverage -o $@ $(SRCDIR)test/infcover.c

infcover: infcover.o libz.a
	$(CC) $(CFLAGS) -coverage -o $@ infcover.o libz.a

cover: infcover
	rm -f *.gcda
	${QEMU_RUN} ./infcover
	${GCOV} ${LLVM_GCOV_FLAG} inf*.c -o ./infcover.gcda

# The four targets below build and verify the Rust reimplementation of zlib.
# They are standalone by design, for two independent reasons.  First, configure
# rewrites the entire prerequisite list of `all' and of `test' (its sed script
# contains /^all: */s#:.*#: $ALL# and /^test: */s#:.*#: $TEST#), so anything
# appended to either line here would be discarded the next time configure ran.
# Second, the C library is the reference the Rust implementation is diffed
# against, so `make' and `make test' have to keep working byte for byte as
# before, on machines that have no Rust toolchain at all.
#
# All four REQUIRE ./configure to have run.  The checked-in placeholder Makefile
# refuses `rust', `rust-test' and `rust-symbols' with a message saying so, and
# `distclean' regenerates that refusal verbatim; only `rust-clean' is forwarded,
# because it removes directories and needs nothing configure computes.  The
# reason for the refusal is $(LDSHARED): unconfigured it is plain $(CC), with no
# platform flag asking for a shared object, so the relink below cannot run at
# all.  Staging cargo's own cdylib instead is not an option -- see the comment
# on the `rust' recipe for what that library is missing.

# Build the Rust crates, then the C-ABI library, then package the result under
# $(RUSTLIBDIR) with the same three names, the same SONAME and the same version
# script the C build gives $(SHAREDLIBV).
#
# THE SHARED OBJECT IS ALWAYS RELINKED, NEVER COPIED, and that is the whole
# point of this recipe.  It used to relink only when $(LDSHARED) happened to
# mention a version script, and to copy cargo's cdylib otherwise -- which meant
# that on the unconfigured path, and on every platform whose configure-built
# LDSHARED carries no such flag, `make rust' staged a library with ZERO version
# nodes and no gzprintf, printed a note about it, and exited 0.  The flags are
# now this file's own ($(RUSTSHAREDFLAG), $(RUSTSONAMEFLAG),
# $(RUSTVERSIONSCRIPTFLAG)$(RUSTVERSIONSCRIPT)), added when $(RUSTLDSHARED) does
# not already carry them, so the relink is correct before configure has ever
# run.  Measured on this tree with an unconfigured Makefile.in: 16 symbol
# version nodes, 95 exported functions, SONAME libz.so.1, and 111 dynamic
# globals identical to the C libz.so.1.3.2.1-motley.  Cargo's cdylib link cannot be given $(SRCDIR)zlib.map: rustc supplies
# a version script of its own, and a second one is either rejected outright
# ("anonymous version tag cannot be combined with other version tags") or
# silently produces a library with zero version nodes.  The long comment above
# `reject_version_script_passthrough` in crates/libz-rs-sys/build.rs records
# every spelling that was tried, and that script now REFUSES the request rather
# than emitting it.  So the shared object is relinked here from $(STATICLIB) --
# which the same cargo build already produced -- through $(LDSHARED), the exact
# variable the $(SHAREDLIBV) rule at the bottom of this file uses.  Whatever
# soname and version script `configure' baked into it therefore apply to the
# Rust library byte for byte, with no second place for them to drift.
#
# THE STAGED NAME COMES FROM zlib.h, NOT FROM $(SHAREDLIBV).  $(RUSTZVERCMD)
# reads ZLIB_VERSION exactly as configure L56 does, and the versioned name and
# soname are derived from it; $(SHAREDLIBV) is read for one thing only, that
# `configure --static' empties it.  Before this, staging used $(SHAREDLIBV)
# whose unconfigured default is the stale `libz.so.1.3.2.1', while `rust-test'
# derived `libz.so.1.3.2.1-motley' from the header -- so the file the test
# looked for never existed, the target quietly linked the C drivers against
# $(STATICLIB) instead, and a green run meant the shared library had not been
# tested at all.  The name now has exactly one source.
#
# WHAT THE GATE AT THE END OF THIS RECIPE CHECKS, unconditionally, against the
# two immutable contract files -- and it is a hard failure, never a skip:
#
#   1. Every function $(SRCDIR)zlib.h declares is exported, and nothing else
#      is.  Both directions, on every platform.  The expected set is DERIVED
#      from the header so it cannot go stale: every ZEXTERN...ZEXPORT[VA] name,
#      less $(RUSTMACROFN) (the five whose real entry point is the _-suffixed
#      one their like-named macro expands to) and, off Windows, less
#      $(RUSTWINONLY).  gzgetc is deliberately NOT excluded: it too is shadowed
#      by a macro, but that macro's else branch calls the real function through
#      (gzgetc)(g), so the symbol has to exist.  $(RUSTRUNTIMESYMS) is excluded
#      from the exported side.
#      This is the check `-Wl,--undefined-version' makes necessary.  That flag
#      is required -- zlib.map's `local:' names are pub(crate) Rust items that
#      never become symbols, so without it the linker refuses the script -- and
#      the price is that a MISSING public name is no longer a link error.  So it
#      is checked here by name instead.
#   2. None of zlib.map's `local:' names is exported, and nothing matching _* is.
#   3. The symbol version nodes are exactly the set zlib.map declares, and a
#      library that carries ZERO of them when a version script was required is
#      deleted and the build fails -- that state passes every name-based check
#      and still cannot satisfy a consumer resolving deflate@ZLIB_1.2.0.
#   4. The SONAME is the derived $$SOM, without which an already-linked consumer
#      binds the system libz instead.
#   5. If a C reference library exists ($(ZLIBREF), overridable), its dynamic
#      symbol table is diffed against the staged one.  This is an EXTRA check;
#      1 to 4 do not depend on it.
#
# Checks 2 and 3 are version-script constructs.  When $(RUSTVERSIONSCRIPT) or
# $(RUSTVERSIONSCRIPTFLAG) is explicitly emptied -- the documented way to say
# "this format has no such concept", as on Mach-O -- they are reported as not
# applicable rather than failed, because there they would measure the object
# format rather than the port, and the C library on such a platform exports its
# internals too.  Check 1 still runs.  What is no longer possible is reaching
# that state by accident.
#
# Packaging happens in $(RUSTLIBDIR), never in $(RUSTDIR), for two reasons that
# have nothing to do with each other.  The first is that the two libraries are
# not the same file: $(RUSTDIR) holds cargo's own cdylib, which carries no
# version nodes and no gzprintf, and overwriting it would destroy the input this
# recipe relinks from.  The second is isolation: cargo puts $(RUSTDIR) first on
# LD_LIBRARY_PATH for everything it launches, and every host tool that records
# `DT_NEEDED libz.so.1' -- nm, readelf and ld.bfd all do -- then resolves libz
# out of the build directory.
#
# Note what does NOT live in $(RUSTDIR), and that this recipe is the only reason
# it does not have to.  crates/libz-rs-sys/build.rs used to stage $(SHAREDLIBM)
# and the versioned name there as symlinks to cargo's $(SHAREDLIB), so that a
# consumer of the CARGO output could not silently bind the system libz instead.
# It no longer does, and both halves of the isolation argument above are why: a
# build script runs before the link, so those symlinks were left dangling by
# `cargo check', by any failed build and by `cargo clean -p', and a dangling
# $(SHAREDLIBM) on a loader path falls through to the system libz exactly as if
# it were absent; and the name being present is what put cargo's incomplete
# cdylib under nm, ar, as and rustc themselves -- measured, up to 32 `no version
# information available' notices in one build, and a hard `as: symbol lookup
# error: undefined symbol: deflate' once a --no-default-features build had left a
# zero-export library at that name.  Both build scripts additionally strip
# LD_LIBRARY_PATH before spawning a libz-linked tool.  So $(RUSTDIR) holds
# cargo's $(SHAREDLIB), $(STATICLIB), the rlib and a README naming which of them
# may be installed, and the versioned chain exists in exactly one place: here,
# staged by a step that runs AFTER the link, on the library that is relinked
# through zlib.map and carries the gzprintf shim.
#
# The symlinks staged here are not cosmetic: the SONAME is $(SHAREDLIBM), so a
# consumer asks the loader for that exact name, and when only $(SHAREDLIB)
# exists the loader quietly falls back to the system $(SHAREDLIBM) and the
# drop-in test passes while exercising the wrong library.  When configure was run
# with --static, $(SHAREDLIBV) is empty and only $(STATICLIB) is staged.
#
# Three variables are exported into the cargo build: CC, CFLAGS and AR.  cargo is
# what compiles $(RUSTSHIMDIR) -- crates/libz-rs-sys/build.rs drives the platform
# compiler directly -- so exporting this build's own toolchain is what keeps the C
# objects inside cargo's $(STATICLIB) built with the same compiler and the same flags
# as everything else here.  $(RUSTSHIMFLAGS) is appended to $(SFLAGS) because those
# objects are archived and then relinked into a shared library below, so they must be
# position-independent.
#
# Nothing tells the Rust code what the finished library will contain any more, and
# that is the point: the archive cargo produces already defines gzprintf, gzvprintf
# and inflate_table, so cfg(zlib_rs_gzprintf) -- and with it zlibCompileFlags() bit
# 27 -- follows from the compile that actually happened.  The recipe verifies the
# three symbols are present in the staged archive before it relinks anything.
#
# Package selection is explicit.  `-p zlib-rs -p libz-rs-sys' names the two
# crates that ship; the third workspace member, crates/zlib-rs-differential,
# compiles the in-tree C sources from its build script and is deliberately not
# built here.  `--features libz-compat' is likewise package-scoped: with several
# packages selected cargo applies a bare feature name only to the ones that
# declare it, so naming the crate is what makes the command say what it means.
#
# .PHONY BELOW IS REQUIRED, NOT TIDINESS.  `rust' is also the name of a directory
# in this tree -- rust/README.md, the developer guide -- and make treats a target
# whose name matches an existing file or directory as up to date when it has no
# prerequisites.  Without the declaration, `make rust' prints "'rust' is up to
# date", runs nothing, and still exits 0: a silent no-op, which is worse than an
# error because every caller downstream of it, `make rust-test' and
# `make rust-symbols' included, then reports success against an unstaged library.
# The whole rust* family is declared rather than just `rust', so a later addition
# under any of these names cannot reintroduce the same trap.  The forwarding copy
# of these targets in the pre-configure `Makefile' carries the same declaration
# and the same reason; keep the two in step.
.PHONY: rust rust-pc rust-test rust-symbols rust-header rust-msrv rust-clean

rust:
	@if test -z "$(CARGO)"; then \
	  echo 'make rust: no Rust toolchain -- $$(CARGO) is empty' >&2; \
	  echo 'make rust: install cargo, then re-run ./configure, or name it:' >&2; \
	  echo 'make rust:     make rust CARGO=cargo' >&2; \
	  exit 1; \
	fi; \
	set -e; \
	$(RUSTPATHGUARD); \
	case " $(CARGO_BUILD_FLAGS) " in \
	  *' --features'* | *' --no-default-features '* | *' -F '*) \
	    echo 'make rust: CARGO_BUILD_FLAGS names Cargo features, and this target owns' >&2; \
	    echo 'make rust: that decision: the staged archive contains the gzprintf shim,' >&2; \
	    echo 'make rust: whose two Rust adapters exist only behind the libz-compat and' >&2; \
	    echo 'make rust: gz features, so a build without either one stages a library' >&2; \
	    echo 'make rust: with two unresolved symbols.  Set the feature lists instead:' >&2; \
	    echo 'make rust:     make rust RUSTSYSFEATURES=libz-compat,gz,simd' >&2; \
	    echo 'make rust:     make rust RUSTCOREFEATURES=simd' >&2; \
	    exit 1;; \
	esac; \
	CORE_FEATURES='$(RUSTCOREFEATURES)'; SYS_FEATURES='$(RUSTSYSFEATURES)'; \
	case ",$$SYS_FEATURES," in \
	  *,libz-compat,*) ;; \
	  *) echo 'make rust: RUSTSYSFEATURES must include libz-compat, or the staged' >&2; \
	     echo 'make rust: library exports nothing at all.' >&2; \
	     exit 1;; \
	esac; \
	case ",$$SYS_FEATURES," in \
	  *,gz,*) ;; \
	  *) echo 'make rust: RUSTSYSFEATURES must include gz.  The gzprintf shim this' >&2; \
	     echo 'make rust: recipe archives into the staged library calls two Rust' >&2; \
	     echo 'make rust: adapters that only exist behind it, so the result would' >&2; \
	     echo 'make rust: carry unresolved symbols.' >&2; \
	     exit 1;; \
	esac; \
	case "$${ZLIB_RS_SIMD-}" in \
	  '') ;; \
	  0) case ",$$CORE_FEATURES,$$SYS_FEATURES," in \
	       *,simd,*) \
	         echo 'make rust: ZLIB_RS_SIMD=0 contradicts the simd feature already named in' >&2; \
	         echo 'make rust: RUSTCOREFEATURES or RUSTSYSFEATURES.  Drop one of the two.' >&2; \
	         exit 1;; \
	     esac;; \
	  1) case ",$$CORE_FEATURES," in *,simd,*) ;; \
	       *) CORE_FEATURES="$${CORE_FEATURES:+$$CORE_FEATURES,}simd";; esac; \
	     case ",$$SYS_FEATURES," in *,simd,*) ;; \
	       *) SYS_FEATURES="$$SYS_FEATURES,simd";; esac;; \
	  *) echo "make rust: ZLIB_RS_SIMD must be 0 or 1, got \"$${ZLIB_RS_SIMD}\"" >&2; \
	     exit 1;; \
	esac; \
	if test -n "$$CORE_FEATURES"; then CORE_FEATURES="--features $$CORE_FEATURES"; fi; \
	CARGO_TARGET_DIR=$(RUSTTARGETDIR); export CARGO_TARGET_DIR; \
	CC="$(CC)"; export CC; \
	CFLAGS="$(SFLAGS) $(RUSTSHIMFLAGS)"; export CFLAGS; \
	AR="$(AR)"; export AR; \
	echo "$(CARGO) build $(CARGO_BUILD_FLAGS) -p zlib-rs $$CORE_FEATURES"; \
	$(CARGO) build $(CARGO_BUILD_FLAGS) --manifest-path $(SRCDIR)Cargo.toml \
	  -p zlib-rs $$CORE_FEATURES; \
	echo "$(CARGO) build $(CARGO_BUILD_FLAGS) -p libz-rs-sys --features $$SYS_FEATURES"; \
	$(CARGO) build $(CARGO_BUILD_FLAGS) --manifest-path $(SRCDIR)Cargo.toml \
	  -p libz-rs-sys --features "$$SYS_FEATURES"
	@if test -z "$(CARGO)"; then \
	  echo 'make rust: reached the packaging step with no $$(CARGO); the recipe line' >&2; \
	  echo 'make rust: above should already have refused.  Not continuing.' >&2; \
	  exit 1; \
	fi; \
	set -e; \
	LC_ALL=C; export LC_ALL; \
	rustdir='$(RUSTDIR)'; \
	if test -z "$$rustdir"; then \
	  profile=debug; triple=; want=; \
	  for arg in $(CARGO_BUILD_FLAGS); do \
	    if test -n "$$want"; then \
	      eval "$$want=\$$arg"; want=; continue; \
	    fi; \
	    case "$$arg" in \
	      --release | -r) profile=release ;; \
	      --profile) want=profile ;; \
	      --profile=*) profile=`expr "$$arg" : '--profile=\(.*\)'` ;; \
	      --target) want=triple ;; \
	      --target=*) triple=`expr "$$arg" : '--target=\(.*\)'` ;; \
	    esac; \
	  done; \
	  case "$$profile" in dev | test) profile=debug ;; bench) profile=release ;; esac; \
	  rustdir='$(RUSTTARGETDIR)'; \
	  test -z "$$triple" || rustdir="$$rustdir/$$triple"; \
	  rustdir="$$rustdir/$$profile"; \
	fi; \
	if test ! -f "$$rustdir/$(STATICLIB)"; then \
	  echo "make rust: $$rustdir/$(STATICLIB) was not produced" >&2; \
	  echo "make rust: pass RUSTDIR=<dir> if cargo writes somewhere else" >&2; \
	  exit 1; \
	fi; \
	echo "make rust: cargo artifacts read from $$rustdir"; \
	ZVER=`$(RUSTZVERCMD)`; \
	if test -z "$$ZVER"; then \
	  echo "make rust: no ZLIB_VERSION in $(SRCDIR)zlib.h, so the versioned library" >&2; \
	  echo "make rust: name cannot be derived.  That macro is the library's version" >&2; \
	  echo "make rust: identity and the header must not be edited." >&2; \
	  exit 1; \
	fi; \
	ZMAJOR=`expr "$$ZVER" : '\([0-9][0-9]*\)'`; \
	case "$(SHAREDLIB)" in \
	  *.dylib) SOV="libz.$$ZVER.dylib"; SOM="libz.$$ZMAJOR.dylib" ;; \
	  *) SOV="$(SHAREDLIB).$$ZVER"; SOM="$(SHAREDLIB).$$ZMAJOR" ;; \
	esac; \
	echo "make rust: staging $$SOV, named from ZLIB_VERSION in $(SRCDIR)zlib.h"; \
	if test -n "$(SHAREDLIBV)" && test "$(SHAREDLIBV)" != "$$SOV"; then \
	  echo "make rust: (the C build calls it $(SHAREDLIBV); that name is only the"; \
	  echo "make rust: unconfigured default and disagrees with the header)"; \
	fi; \
	rm -rf $(RUSTLIBDIR); \
	mkdir -p $(RUSTLIBDIR); \
	cp -p "$$rustdir/$(STATICLIB)" $(RUSTLIBDIR)/$(STATICLIB); \
	echo "cp $$rustdir/$(STATICLIB) $(RUSTLIBDIR)/$(STATICLIB)"; \
	for sym in $(RUSTSHIMSYMS); do \
	  if $(RUSTNM) $(RUSTLIBDIR)/$(STATICLIB) 2>/dev/null \
	      | grep -q "^[0-9a-fA-F]* *T $$sym$$"; then :; else \
	    echo "make rust: $(STATICLIB) does not define $$sym." >&2; \
	    echo "make rust: cargo compiles $(RUSTSHIMDIR) into the archive it produces" >&2; \
	    echo "make rust: (crates/libz-rs-sys/build.rs), so a missing name means that" >&2; \
	    echo "make rust: build ran without a C compiler or without the libz-compat and" >&2; \
	    echo "make rust: gz features.  This target will not stage an incomplete libz." >&2; \
	    exit 1; \
	  fi; \
	done; \
	echo "		$(STATICLIB) defines the C-ABI shim symbols cargo compiled:$(RUSTSHIMSYMS)"; \
	if test -n "$(RUSTPCPRIVATE)"; then \
	  NSL='$(RUSTPCPRIVATE)'; \
	  echo "		native static libraries stated by RUSTPCPRIVATE: $$NSL"; \
	elif $(RUSTC) --version >/dev/null 2>&1; then \
	  printf '#[no_mangle]\npub extern "C" fn zlib_rs_native_static_libs_probe() -> i32 { 0 }\n' \
	    > $(RUSTLIBDIR)/nsl-probe.rs; \
	  if $(RUSTC) --print native-static-libs --crate-type staticlib \
	      -o $(RUSTLIBDIR)/libnsl-probe.a $(RUSTLIBDIR)/nsl-probe.rs \
	      > $(RUSTLIBDIR)/nsl.log 2>&1; then \
	    NSL=`sed -n 's/.*native-static-libs: *//p' $(RUSTLIBDIR)/nsl.log \
	         | sed -n '1p'`; \
	  else \
	    NSL=''; \
	  fi; \
	  rm -f $(RUSTLIBDIR)/nsl-probe.rs $(RUSTLIBDIR)/libnsl-probe.a \
	    $(RUSTLIBDIR)/nsl.log; \
	else \
	  NSL=''; \
	fi; \
	printf '%s\n' "$$NSL" > $(RUSTLIBDIR)/native-static-libs.stage; \
	if test -n "$$NSL"; then \
	  echo "		static-linking $(STATICLIB) additionally needs: $$NSL"; \
	  echo '		(from `$(RUSTC) --print native-static-libs'"'"'; target-specific, so'; \
	  echo '		it is recorded in $(RUSTLIBDIR)/native-static-libs.stage and used by'; \
	  echo '		the relink below, by the static links `make rust-test'"'"' performs, and'; \
	  echo '		by the Libs.private: line `make rust-pc'"'"' writes)'; \
	else \
	  echo '		could not ask $(RUSTC) which native libraries $(STATICLIB) needs'; \
	  echo '		beside it; the shared relink below adds none, and `make rust-test'"'"''; \
	  echo '		and `make rust-pc'"'"' will stop rather than link or advertise an'; \
	  echo '		archive whose requirements are unknown.  Pass RUSTC=<path>, or state'; \
	  echo '		the set with RUSTPCPRIVATE="-lm -lpthread -lc".'; \
	fi; \
	sed -n 's/^ *ZEXTERN[^(]*[ *]\([A-Za-z_][A-Za-z0-9_]*\) *(.*/\1/p' \
	  $(SRCDIR)zlib.h | sort -u > $(RUSTLIBDIR)/public.syms; \
	printf '%s\n%s\n' "$$SOV" "$$SOM" > $(RUSTLIBDIR)/soname.stage; \
	if test -z "$(SHAREDLIBV)"; then \
	  echo static >> $(RUSTLIBDIR)/soname.stage; \
	  echo '		configured --static: only $(STATICLIB) was staged'; \
	  exit 0; \
	fi; \
	LDS='$(RUSTLDSHARED)'; \
	EXTRA=''; \
	case " $$LDS " in \
	  *-shared* | *-dynamiclib* | *-G* ) ;; \
	  *) EXTRA="$$EXTRA $(RUSTSHAREDFLAG)";; \
	esac; \
	case " $$LDS " in \
	  *-soname* | *install_name* | *,-h* ) ;; \
	  *) EXTRA="$$EXTRA $(RUSTSONAMEFLAG)$$SOM";; \
	esac; \
	VSMODE=none; VSARG=''; \
	if test -n '$(RUSTVERSIONSCRIPT)' && test -n '$(RUSTVERSIONSCRIPTFLAG)'; then \
	  if test ! -f '$(RUSTVERSIONSCRIPT)'; then \
	    echo "make rust: the version script $(RUSTVERSIONSCRIPT) is missing.  It is part" >&2; \
	    echo "make rust: of zlib's immutable contract: it declares the symbol version" >&2; \
	    echo "make rust: nodes and the local: block that keeps the internals out of the" >&2; \
	    echo "make rust: dynamic table.  Restore it from version control." >&2; \
	    exit 1; \
	  fi; \
	  VSMODE=required; \
	  case " $$LDS " in \
	    *version-script*) VSMODE=ldshared;; \
	    *) VSARG='$(RUSTVERSIONSCRIPTFLAG)$(RUSTVERSIONSCRIPT)';; \
	  esac; \
	else \
	  echo '		RUSTVERSIONSCRIPT or RUSTVERSIONSCRIPTFLAG is empty, so no version'; \
	  echo '		script is applied.  That is an explicit choice for a format that'; \
	  echo '		has no such concept; the export-set comparison still runs.'; \
	fi; \
	echo "$(CC) -r -nostdlib -o $(RUSTLIBDIR)/libz-whole.o $(RUSTWHOLEARCHIVE) $(RUSTLIBDIR)/$(STATICLIB) $(RUSTNOWHOLEARCHIVE)"; \
	$(CC) -r -nostdlib -o $(RUSTLIBDIR)/libz-whole.o \
	  $(RUSTWHOLEARCHIVE) $(RUSTLIBDIR)/$(STATICLIB) $(RUSTNOWHOLEARCHIVE); \
	$(RUSTNM) --defined-only --extern-only --format=posix \
	  $(RUSTLIBDIR)/libz-whole.o \
	  | awk '$$2 ~ /^[TDBRGSi]$$/ { print $$1 }' | sed -n '/^_/!p' | sort -u \
	  > $(RUSTLIBDIR)/whole.syms; \
	comm -23 $(RUSTLIBDIR)/whole.syms $(RUSTLIBDIR)/public.syms \
	  > $(RUSTLIBDIR)/hidden.syms; \
	if test -s $(RUSTLIBDIR)/hidden.syms; then \
	  echo "$(RUSTOBJCOPY) --localize-symbols=$(RUSTLIBDIR)/hidden.syms $(RUSTLIBDIR)/libz-whole.o"; \
	  $(RUSTOBJCOPY) --localize-symbols=$(RUSTLIBDIR)/hidden.syms \
	    $(RUSTLIBDIR)/libz-whole.o; \
	fi; \
	echo "$$LDS $(SFLAGS)$$EXTRA $$VSARG -o $(RUSTLIBDIR)/$$SOV $(RUSTLIBDIR)/libz-whole.o $(LDSHAREDLIBC) $(LDFLAGS) $$NSL"; \
	if $$LDS $(SFLAGS) $$EXTRA $$VSARG -Wl,--undefined-version \
	    -o "$(RUSTLIBDIR)/$$SOV" $(RUSTLIBDIR)/libz-whole.o \
	    $(LDSHAREDLIBC) $(LDFLAGS) $$NSL 2> $(RUSTLIBDIR)/relink.log; then \
	  :; \
	elif $$LDS $(SFLAGS) $$EXTRA $$VSARG -o "$(RUSTLIBDIR)/$$SOV" \
	    $(RUSTLIBDIR)/libz-whole.o $(LDSHAREDLIBC) $(LDFLAGS) $$NSL \
	    2>> $(RUSTLIBDIR)/relink.log; then \
	  echo 'note: the linker rejected --undefined-version; relinked without it'; \
	elif test -n "$$rustvs" && $(LDSHARED) $(SFLAGS) -Wl,--undefined-version \
	    -o $(RUSTLIBDIR)/$(SHAREDLIBV) $(RUSTLIBDIR)/libz-whole.o \
	    $(LDSHAREDLIBC) $(LDFLAGS) $$NSL 2>> $(RUSTLIBDIR)/relink.log; then \
	  echo 'note: this linker rejects --version-script; relinked without one'; \
	  : > $(RUSTLIBDIR)/unversioned; \
	elif test -n "$$rustvs" && $(LDSHARED) $(SFLAGS) \
	    -o $(RUSTLIBDIR)/$(SHAREDLIBV) $(RUSTLIBDIR)/libz-whole.o \
	    $(LDSHAREDLIBC) $(LDFLAGS) $$NSL 2>> $(RUSTLIBDIR)/relink.log; then \
	  echo 'note: this linker rejects --version-script and --undefined-version'; \
	  : > $(RUSTLIBDIR)/unversioned; \
	else \
	  cat $(RUSTLIBDIR)/relink.log; \
	  rm -f $(RUSTLIBDIR)/libz-whole.o $(RUSTLIBDIR)/relink.log; \
	  echo "		*** relink of $$SOV from $(STATICLIB) FAILED ***"; \
	  echo "		The staged library is NOT a drop-in and nothing was substituted" >&2; \
	  echo "		for it.  Fix the link, or state the platform's own spellings:" >&2; \
	  echo "		    make rust RUSTSONAMEFLAG=-Wl,-install_name, RUSTVERSIONSCRIPT=" >&2; \
	  exit 1; \
	fi; \
	rm -f $(RUSTLIBDIR)/relink.log; \
	rm -f $(RUSTLIBDIR)/libz-whole.o; \
	if test "$$VSMODE" != none && command -v $(RUSTNM) > /dev/null 2>&1; then \
	  NODES=`$(RUSTNM) -D --defined-only --extern-only "$(RUSTLIBDIR)/$$SOV" \
	    | awk '$$2 == "A"' | wc -l`; \
	  if test "$$NODES" -eq 0; then \
	    echo "make rust: $$SOV carries ZERO symbol version nodes, although a version" >&2; \
	    echo "make rust: script was required.  That is the failure this step exists to" >&2; \
	    echo "make rust: catch: the library links, loads and passes every name-based" >&2; \
	    echo "make rust: check, and yet no consumer resolving deflate@ZLIB_1.2.0 can" >&2; \
	    echo "make rust: bind to it.  VSMODE was $$VSMODE; the arguments used were" >&2; \
	    echo "make rust:     $$LDS $(SFLAGS)$$EXTRA $$VSARG" >&2; \
	    rm -f "$(RUSTLIBDIR)/$$SOV"; \
	    exit 1; \
	  fi; \
	  echo "		$$NODES symbol version nodes in $$SOV"; \
	fi; \
	rm -f "$(RUSTLIBDIR)/$(SHAREDLIB)" "$(RUSTLIBDIR)/$$SOM"; \
	ln -s "$$SOV" "$(RUSTLIBDIR)/$$SOM"; \
	echo "ln -s $$SOV $(RUSTLIBDIR)/$$SOM"; \
	ln -s "$$SOV" $(RUSTLIBDIR)/$(SHAREDLIB); \
	echo "ln -s $$SOV $(RUSTLIBDIR)/$(SHAREDLIB)"; \
	echo "$$VSMODE" >> $(RUSTLIBDIR)/soname.stage
	@if test -z "$(CARGO)"; then \
	  echo 'make rust: reached the export gate with no $$(CARGO); the recipe lines' >&2; \
	  echo 'make rust: above should already have refused.  Not continuing.' >&2; \
	  exit 1; \
	fi; \
	set -e; \
	LC_ALL=C; export LC_ALL; \
	SOV=`sed -n 1p $(RUSTLIBDIR)/soname.stage`; \
	SOM=`sed -n 2p $(RUSTLIBDIR)/soname.stage`; \
	VSMODE=`sed -n 3p $(RUSTLIBDIR)/soname.stage`; \
	if test "$$VSMODE" = static; then \
	  echo '		static-only build: the export comparison needs a shared object and'; \
	  echo '		was not run.  $(STATICLIB) is staged and `rust-test'\'' still links the'; \
	  echo '		C drivers against it.'; \
	  exit 0; \
	fi; \
	if test ! -f "$(RUSTLIBDIR)/$$SOV"; then \
	  echo "make rust: $(RUSTLIBDIR)/$$SOV does not exist, so the staged library was" >&2; \
	  echo "make rust: never produced and its exports cannot be checked.  This is a" >&2; \
	  echo "make rust: hard failure on purpose: falling back to $(STATICLIB) here is how" >&2; \
	  echo "make rust: a green run used to mean the shared library had not been tested." >&2; \
	  exit 1; \
	fi; \
	if ! command -v $(RUSTNM) > /dev/null 2>&1; then \
	  echo "make rust: $(RUSTNM) is unavailable, so the exported symbol set cannot be" >&2; \
	  echo "make rust: compared against $(SRCDIR)zlib.h.  That comparison is the only" >&2; \
	  echo "make rust: check that a public function is actually exported, so it is" >&2; \
	  echo "make rust: required rather than optional.  Name a symbol reader:" >&2; \
	  echo "make rust:     make rust RUSTNM=llvm-nm" >&2; \
	  exit 1; \
	fi; \
	rc=0; \
	$(RUSTNM) -D --defined-only --extern-only "$(RUSTLIBDIR)/$$SOV" \
	  > $(RUSTLIBDIR)/nm.out; \
	awk '{ print $$3 }' $(RUSTLIBDIR)/nm.out | sort > $(RUSTLIBDIR)/rust.syms; \
	awk '$$2 != "A" { sub(/@@.*/, "", $$3); print $$3 }' $(RUSTLIBDIR)/nm.out \
	  | sort -u > $(RUSTLIBDIR)/exported.syms; \
	awk '$$2 == "A" { print $$3 }' $(RUSTLIBDIR)/nm.out | sort -u \
	  > $(RUSTLIBDIR)/so.nodes; \
	skip=; for n in $(RUSTMACROFN); do skip="$$skip -e $$n"; done; \
	if test -z "$(EXE)"; then \
	  for n in $(RUSTWINONLY); do skip="$$skip -e $$n"; done; \
	fi; \
	grep -v -x $$skip $(RUSTLIBDIR)/public.syms > $(RUSTLIBDIR)/want.syms; \
	keep=; for n in $(RUSTRUNTIMESYMS); do keep="$$keep -e $$n"; done; \
	grep -v -x $$keep $(RUSTLIBDIR)/exported.syms > $(RUSTLIBDIR)/have.syms || true; \
	comm -23 $(RUSTLIBDIR)/want.syms $(RUSTLIBDIR)/have.syms \
	  > $(RUSTLIBDIR)/missing.syms; \
	comm -13 $(RUSTLIBDIR)/want.syms $(RUSTLIBDIR)/have.syms \
	  > $(RUSTLIBDIR)/extra.syms; \
	if test -s $(RUSTLIBDIR)/missing.syms; then \
	  echo '		declared in $(SRCDIR)zlib.h, NOT exported by the staged library:'; \
	  sed 's/^/		  /' $(RUSTLIBDIR)/missing.syms; \
	  rc=1; \
	fi; \
	if test -s $(RUSTLIBDIR)/extra.syms; then \
	  if test "$$VSMODE" = none; then \
	    echo "		exported without being declared in $(SRCDIR)zlib.h (`wc -l < $(RUSTLIBDIR)/extra.syms` names)."; \
	    echo '		Not a failure here: no version script was applied, so nothing can'; \
	    echo '		hide an internal, and the C library on such a platform exports'; \
	    echo '		them too.  The first few are printed so it stays visible; the'; \
	    echo '		full list is $(RUSTLIBDIR)/extra.syms:'; \
	    sed 's/^/		  /' $(RUSTLIBDIR)/extra.syms | head -10; \
	  else \
	    echo '		exported, but not declared in $(SRCDIR)zlib.h:'; \
	    sed 's/^/		  /' $(RUSTLIBDIR)/extra.syms; \
	    rc=1; \
	  fi; \
	fi; \
	if test ! -s $(RUSTLIBDIR)/missing.syms; then \
	  echo "		every one of the `wc -l < $(RUSTLIBDIR)/want.syms` functions $(SRCDIR)zlib.h declares is exported"; \
	fi; \
	WANTN=`wc -l < $(RUSTLIBDIR)/want.syms | tr -d ' '`; \
	if test -n "$(EXE)" || test -z "$(RUSTPUBLICFNS)"; then \
	  echo "		$$WANTN functions expected on this platform; the $(RUSTPUBLICFNS)-function"; \
	  echo '		count is the Linux contract and is not asserted here'; \
	elif test "$$WANTN" -ne $(RUSTPUBLICFNS); then \
	  echo "		$(SRCDIR)zlib.h now yields $$WANTN public functions, not $(RUSTPUBLICFNS)."; \
	  echo '		That header is immutable, so the set this gate derives from it must not'; \
	  echo '		change: either the header was edited or the derivation stopped matching'; \
	  echo '		it.  Without this check a changed contract would be absorbed silently,'; \
	  echo '		because the comparison above is derived-want against exported-have.'; \
	  rc=1; \
	else \
	  echo "		and that is exactly $(RUSTPUBLICFNS) functions, as $(SRCDIR)zlib.h's frozen contract requires"; \
	fi; \
	sed -n '/^ *local:/,/}/{ s/^ *\([A-Za-z_][A-Za-z0-9_]*\);.*/\1/p; }' \
	  $(SRCDIR)zlib.map | sort -u > $(RUSTLIBDIR)/local.syms; \
	comm -12 $(RUSTLIBDIR)/local.syms $(RUSTLIBDIR)/exported.syms \
	  > $(RUSTLIBDIR)/leaked.syms; \
	sed -n '/^_/p' $(RUSTLIBDIR)/exported.syms >> $(RUSTLIBDIR)/leaked.syms; \
	if test -s $(RUSTLIBDIR)/leaked.syms; then \
	  if test "$$VSMODE" = none; then \
	    echo '		$(SRCDIR)zlib.map local: names are exported here.  Not a failure: that'; \
	    echo '		block is a version-script construct and no version script was'; \
	    echo '		applied, so this measures the object format rather than the port.'; \
	  else \
	    echo '		$(SRCDIR)zlib.map hides these, but they are exported:'; \
	    sed 's/^/		  /' $(RUSTLIBDIR)/leaked.syms; \
	    rc=1; \
	  fi; \
	else \
	  echo "		all `wc -l < $(RUSTLIBDIR)/local.syms` $(SRCDIR)zlib.map local: names hidden, nothing matching _* exported"; \
	fi; \
	if test "$$VSMODE" = none; then \
	  echo '		no version script was applied, by explicit request, so the symbol'; \
	  echo '		version nodes were not compared.  A consumer that resolves a'; \
	  echo '		versioned symbol cannot bind this library.'; \
	else \
	  sed -n 's/^\([A-Za-z_][A-Za-z0-9_.]*\)[[:space:]]*{.*/\1/p' $(SRCDIR)zlib.map \
	    | sort -u > $(RUSTLIBDIR)/map.nodes; \
	  if diff -u $(RUSTLIBDIR)/map.nodes $(RUSTLIBDIR)/so.nodes; then \
	    echo "		`wc -l < $(RUSTLIBDIR)/so.nodes` symbol version nodes, exactly as $(SRCDIR)zlib.map declares"; \
	  else \
	    echo '		symbol version nodes differ from $(SRCDIR)zlib.map, see the diff above'; \
	    rc=1; \
	  fi; \
	  NODEN=`wc -l < $(RUSTLIBDIR)/so.nodes | tr -d ' '`; \
	  if test -z "$(RUSTVERNODES)"; then \
	    echo "		$$NODEN nodes; the node count is not asserted"; \
	  elif test "$$NODEN" -ne $(RUSTVERNODES); then \
	    echo "		$$NODEN symbol version nodes, not $(RUSTVERNODES)."; \
	    echo '		$(SRCDIR)zlib.map is immutable, so its node set must not change: a'; \
	    echo '		consumer already linked against a node this library no longer defines'; \
	    echo '		fails to bind at load time.  The diff above compares the map against'; \
	    echo '		the artifact; this compares the map against the frozen contract.'; \
	    rc=1; \
	  else \
	    echo "		and that is exactly $(RUSTVERNODES) nodes, as $(SRCDIR)zlib.map's frozen contract requires"; \
	  fi; \
	fi; \
	if command -v readelf > /dev/null 2>&1; then \
	  if readelf -d "$(RUSTLIBDIR)/$$SOV" | grep -q "\[$$SOM\]"; then \
	    echo "		SONAME is $$SOM"; \
	  else \
	    echo "		SONAME is not $$SOM, so an already-linked consumer will not bind this library"; \
	    rc=1; \
	  fi; \
	else \
	  echo '		no readelf, cannot confirm the SONAME'; \
	fi; \
	if test -f "$(ZLIBREF)"; then \
	  $(RUSTNM) -D --defined-only --extern-only "$(ZLIBREF)" \
	    | awk '{ print $$3 }' | sort > $(RUSTLIBDIR)/c.syms; \
	  if diff -u $(RUSTLIBDIR)/c.syms $(RUSTLIBDIR)/rust.syms; then \
	    echo "		`wc -l < $(RUSTLIBDIR)/rust.syms` symbols, identical to the C $(ZLIBREF)"; \
	  else \
	    echo "		ABI parity diff against the C $(ZLIBREF) shown above"; \
	    rc=1; \
	  fi; \
	else \
	  echo "		the C $(ZLIBREF) is not built here, so the extra C-versus-Rust diff"; \
	  echo '		was skipped: run make first, or name one:'; \
	  echo '		    make rust ZLIBREF=/path/to/libz.so.<version>'; \
	  echo '		Every comparison above is against $(SRCDIR)zlib.h and $(SRCDIR)zlib.map'; \
	  echo '		and does not depend on it.'; \
	fi; \
	if test $$rc -eq 0; then \
	  echo '		*** zlib Rust ABI parity OK ***'; \
	else \
	  echo '		*** zlib Rust ABI parity FAILED ***'; false; \
	fi

# Generate the pkg-config descriptor for the STAGED RUST LIBRARY, then prove a
# static consumer can be built from nothing but that descriptor.
#
# WHY A SECOND DESCRIPTOR EXISTS AT ALL.  For DYNAMIC linking one descriptor
# serves both implementations: -lz resolves to either library, and a shared
# object records its own dependencies in DT_NEEDED, so the loader needs nothing
# advertised.  Static linking is where they part.  The C libz.a needs no
# companion libraries -- which is why the configure-generated zlib.pc carries no
# Libs.private line, and why adding one there would be wrong -- while a Rust
# staticlib carries the Rust runtime and needs that runtime's own native
# libraries on the link line.  Measured on x86_64-unknown-linux-gnu:
#
#     -lgcc_s -lutil -lrt -lpthread -lm -ldl -lc
#
# That set is TARGET-SPECIFIC, so this target derives it with
# `$(RUSTC) --print native-static-libs' for the target being built rather than
# carrying a literal.  A literal would be wrong on the next target along, and
# wrong in the direction that fails to link.
#
# One file could not do both jobs: $(SRCDIR)zlib.pc.in and
# $(SRCDIR)zlib.pc.cmakein are each shared by the two implementations, so the
# only correct place for a Rust-specific key is a Rust-specific file, emitted by
# the Rust packaging step.  $(RUSTPC) is therefore generated FROM the C
# descriptor: everything except the added Libs.private line is copied byte for
# byte, and this recipe asserts that Name, Version, Requires, Libs and Cflags
# came through unchanged.  The two descriptors differ in exactly one key.
#
# WHAT IS AND IS NOT INSTALLED.  This build stages rather than installs the Rust
# library -- `install' installs the C one -- so this target writes the descriptor
# beside the library it describes, in $(RUSTLIBDIR), and prints the copy a
# packager of the staged tree must perform.  The CMake build, which does install
# the Rust artifacts, generates and installs the equivalent file itself, from
# rules declared last so that it wins over the C zlib.pc exactly as the Rust
# libraries win over the C ones.
#
# THE GATE, AND WHY IT IS SHAPED THIS WAY.  A descriptor is only as good as what
# a consumer gets from it, so this target builds one: $(RUSTPCGATE) receives the
# staged archive, the two public headers and a copy of $(RUSTPC) whose five path
# variables point at that directory, and a C program is compiled with the -I
# flags `pkg-config --cflags' answers and linked with the -L and -l flags
# `pkg-config --static --libs' answers.  Nothing else is added to either line, so
# a missing Libs.private is a failing link rather than a silent pass.
#
# The gate directory holds libz.a and NO libz.so, which is what makes the result
# unambiguous: ld searches each -L directory in turn and takes the first match,
# so -lz can only be the archive under test.  `ldd' then has to report no
# dynamic libz at all, and the program itself checks that zlibVersion() returns
# this tree's ZLIB_VERSION, round-trips through compress2/uncompress, agrees with
# itself across crc32 and crc32_z, and drives the gzip layer -- gzprintf, whose
# implementation is the C shim inside the archive, then gzgetc, which is a MACRO
# in $(SRCDIR)zlib.h that reads g->have, g->next and g->pos in the consumer own
# compiled code and therefore only works if the staged library reproduces the
# gzFile_s prefix layout.  A static link is the strictest place to check that.
#
# It also asserts the opposite direction: the private libraries must NOT appear
# in `pkg-config --libs', because dynamic consumption is unchanged by this file
# and a private library leaking into the public answer would over-link every
# dynamic consumer.
#
# pkg-config being absent is not a failure.  The descriptor is still generated
# and every check on its contents still runs; only the link leg is skipped, and
# the skip is printed rather than silent.
rust-pc: rust
	@set -e; \
	LC_ALL=C; export LC_ALL; \
	$(RUSTPATHGUARD); \
	if test ! -f $(RUSTLIBDIR)/$(STATICLIB); then \
	  echo 'make rust-pc: $(RUSTLIBDIR)/$(STATICLIB) is not staged, so there is no' >&2; \
	  echo 'make rust-pc: archive for a descriptor to describe.  The rust target' >&2; \
	  echo 'make rust-pc: stages it, and make runs that target as a prerequisite of' >&2; \
	  echo 'make rust-pc: this one, so reaching here means it failed.' >&2; \
	  exit 1; \
	fi; \
	PRIVATE='$(RUSTPCPRIVATE)'; \
	TARGETDESC=; \
	if test -n "$$PRIVATE"; then \
	  TARGETDESC='stated in RUSTPCPRIVATE for the target being built'; \
	  echo "		Libs.private stated by RUSTPCPRIVATE, not probed: $$PRIVATE"; \
	elif test -s $(RUSTLIBDIR)/native-static-libs.stage; then \
	  PRIVATE=`cat $(RUSTLIBDIR)/native-static-libs.stage`; \
	  TARGETDESC='recorded by `make rust'"'"' for the target being built'; \
	  echo "		Libs.private $$TARGETDESC:$$PRIVATE"; \
	  echo '		(one probe per `make rust'"'"', recorded in'; \
	  echo '		$(RUSTLIBDIR)/native-static-libs.stage, so the descriptor advertises'; \
	  echo '		exactly the set the shared relink and the static links used)'; \
	else \
	  triple=; want=; \
	  for arg in $(CARGO_BUILD_FLAGS); do \
	    if test -n "$$want"; then eval "$$want=\$$arg"; want=; continue; fi; \
	    case "$$arg" in \
	      --target) want=triple ;; \
	      --target=*) triple=`expr "$$arg" : '--target=\(.*\)'` ;; \
	    esac; \
	  done; \
	  if ! command -v $(RUSTC) > /dev/null 2>&1; then \
	    echo 'make rust-pc: $(RUSTC) is unavailable, so the native static library' >&2; \
	    echo 'make rust-pc: list cannot be derived.  It is target-specific, so this' >&2; \
	    echo 'make rust-pc: recipe will not guess it.  Name the compiler, or state' >&2; \
	    echo 'make rust-pc: the list:' >&2; \
	    echo 'make rust-pc:     make rust-pc RUSTC=/path/to/rustc' >&2; \
	    echo 'make rust-pc:     make rust-pc RUSTPCPRIVATE="-lm -lpthread -lc"' >&2; \
	    exit 1; \
	  fi; \
	  tflag=; test -z "$$triple" || tflag="--target $$triple"; \
	  : > $(RUSTLIBDIR)/pc-probe.rs; \
	  if $(RUSTC) --print native-static-libs --crate-type staticlib $$tflag \
	      -o /dev/null $(RUSTLIBDIR)/pc-probe.rs \
	      > $(RUSTLIBDIR)/pc-probe.log 2>&1; then \
	    :; \
	  elif $(RUSTC) --print native-static-libs --crate-type staticlib $$tflag \
	      -o $(RUSTLIBDIR)/pc-probe.a $(RUSTLIBDIR)/pc-probe.rs \
	      > $(RUSTLIBDIR)/pc-probe.log 2>&1; then \
	    rm -f $(RUSTLIBDIR)/pc-probe.a; \
	  else \
	    sed 's/^/		/' $(RUSTLIBDIR)/pc-probe.log >&2; \
	    echo 'make rust-pc: the probe above failed, so the native static library' >&2; \
	    echo 'make rust-pc: list is unknown.  State it instead:' >&2; \
	    echo 'make rust-pc:     make rust-pc RUSTPCPRIVATE="-lm -lpthread -lc"' >&2; \
	    exit 1; \
	  fi; \
	  PRIVATE=`sed -n 's/^note: native-static-libs: *//p' $(RUSTLIBDIR)/pc-probe.log \
	    | sed -n 1p`; \
	  rm -f $(RUSTLIBDIR)/pc-probe.rs; \
	  if test -z "$$PRIVATE"; then \
	    sed 's/^/		/' $(RUSTLIBDIR)/pc-probe.log >&2; \
	    echo 'make rust-pc: $(RUSTC) printed no native-static-libs note above, so' >&2; \
	    echo 'make rust-pc: nothing can be advertised.  A silently empty' >&2; \
	    echo 'make rust-pc: Libs.private is the defect this target exists to' >&2; \
	    echo 'make rust-pc: prevent, so this is a failure rather than a skip.' >&2; \
	    exit 1; \
	  fi; \
	  rm -f $(RUSTLIBDIR)/pc-probe.log; \
	  TARGETDESC="derived with $(RUSTC) for $${triple:-this build host target}"; \
	  echo "		Libs.private $$TARGETDESC: $$PRIVATE"; \
	fi; \
	BASE=$(RUSTLIBDIR)/pc-base; \
	if test -f zlib.pc; then \
	  cp zlib.pc "$$BASE"; \
	  ORIGIN='zlib.pc, as ./configure generated it in this build directory'; \
	else \
	  ZVER=`$(RUSTZVERCMD)`; \
	  if test -z "$$ZVER"; then \
	    echo 'make rust-pc: no ZLIB_VERSION in $(SRCDIR)zlib.h, so the Version field' >&2; \
	    echo 'make rust-pc: cannot be filled.  That macro is the library version' >&2; \
	    echo 'make rust-pc: identity and the header must not be edited.' >&2; \
	    exit 1; \
	  fi; \
	  sed -e 's|^prefix *=.*|prefix=$(prefix)|' \
	      -e 's|^exec_prefix *=.*|exec_prefix=$(exec_prefix)|' \
	      -e 's|^libdir *=.*|libdir=$(libdir)|' \
	      -e 's|^sharedlibdir *=.*|sharedlibdir=$(sharedlibdir)|' \
	      -e 's|^includedir *=.*|includedir=$(includedir)|' \
	      -e "s|@VERSION@|$$ZVER|g" \
	      $(SRCDIR)zlib.pc.in > "$$BASE"; \
	  ORIGIN='$(SRCDIR)zlib.pc.in, substituted from this Makefile because no zlib.pc exists yet'; \
	fi; \
	if grep -q '^Libs\.private' "$$BASE"; then \
	  echo 'make rust-pc: the C descriptor already carries a Libs.private line.' >&2; \
	  echo 'make rust-pc: It must not: the C libz.a needs no companion libraries,' >&2; \
	  echo 'make rust-pc: and this recipe adds that key for the Rust archive only.' >&2; \
	  echo 'make rust-pc: Source: '"$$ORIGIN" >&2; \
	  exit 1; \
	fi; \
	{ printf '%s\n' \
	  '# GENERATED FILE -- do not edit.  Regenerate it with: make rust-pc' \
	  '#' \
	  '# This descriptor describes the STAGED RUST LIBRARY in this directory, not' \
	  '# the C one.  It is a copy of' \
	  "#     $$ORIGIN" \
	  '# with exactly one line added: Libs.private, carrying the native libraries a' \
	  '# Rust staticlib needs on this target.  prefix, libdir, Name, Description,' \
	  '# Version, License, Requires, Libs and Cflags are that file byte for byte,' \
	  '# because dynamic consumption of the two implementations is identical and' \
	  '# only static consumption differs.' \
	  '#' \
	  '# The Libs.private list below is TARGET-SPECIFIC.  Do not copy it to' \
	  '# another target; derive it there.  This one was' \
	  "#     $$TARGETDESC" \
	  '#' \
	  '# INSTALL THIS FILE IN PLACE OF the C zlib.pc whenever the staged Rust' \
	  '# library is the one being installed:' \
	  "#     cp $(RUSTPC) \$$DESTDIR$(pkgconfigdir)/zlib.pc" \
	  '# Leaving the C descriptor in place beside a Rust libz.a is the failure this' \
	  '# file exists to prevent: pkg-config --static --libs would answer -lz alone,' \
	  '# and a consumer that believed it would fail to link.'; \
	  awk -v priv="$$PRIVATE" '{ print } /^Libs:/ { print "Libs.private: " priv }' \
	    "$$BASE"; \
	} > $(RUSTPC); \
	rm -f "$$BASE"; \
	NPRIV=`grep -c '^Libs\.private:' $(RUSTPC)`; \
	if test "$$NPRIV" -ne 1; then \
	  echo "make rust-pc: $(RUSTPC) carries $$NPRIV Libs.private lines, not 1." >&2; \
	  echo 'make rust-pc: pkg-config reads the first and ignores the rest, so a' >&2; \
	  echo 'make rust-pc: second one hides whichever it shadows.' >&2; \
	  exit 1; \
	fi; \
	LINE=`sed -n 's/^Libs\.private: *//p' $(RUSTPC)`; \
	for lib in $$PRIVATE; do \
	  case " $$LINE " in \
	    *" $$lib "*) ;; \
	    *) echo "make rust-pc: $$lib is missing from the generated Libs.private" >&2; \
	       echo "make rust-pc:     Libs.private: $$LINE" >&2; \
	       exit 1;; \
	  esac; \
	done; \
	echo "		Libs.private: $$LINE"; \
	for key in Name Description Version License Requires Libs Cflags; do \
	  a=`sed -n "s/^$$key: *//p" $(RUSTPC)`; \
	  b=`sed -n "s/^$$key: *//p" zlib.pc 2>/dev/null || true`; \
	  if test -f zlib.pc && test "$$a" != "$$b"; then \
	    echo "make rust-pc: the $$key field diverged from the C zlib.pc:" >&2; \
	    echo "make rust-pc:     C   : $$b" >&2; \
	    echo "make rust-pc:     Rust: $$a" >&2; \
	    echo 'make rust-pc: only Libs.private may differ between the two.' >&2; \
	    exit 1; \
	  fi; \
	done; \
	if test -f zlib.pc; then \
	  echo '		every other field is the C zlib.pc byte for byte'; \
	fi; \
	GATE=$(RUSTPCGATE); \
	rm -rf "$$GATE"; \
	mkdir -p "$$GATE/lib" "$$GATE/include" "$$GATE/pkgconfig"; \
	cp $(RUSTLIBDIR)/$(STATICLIB) "$$GATE/lib/$(STATICLIB)"; \
	cp $(SRCDIR)zlib.h "$$GATE/include/zlib.h"; \
	if test -f zconf.h; then \
	  cp zconf.h "$$GATE/include/zconf.h"; \
	elif test -f $(SRCDIR)zconf.h; then \
	  cp $(SRCDIR)zconf.h "$$GATE/include/zconf.h"; \
	else \
	  echo 'make rust-pc: no zconf.h in this build directory or beside zlib.h, so' >&2; \
	  echo 'make rust-pc: the consumer cannot be compiled.  Run ./configure first.' >&2; \
	  exit 1; \
	fi; \
	GATEABS=`cd "$$GATE" && pwd`; \
	sed -e "s|^prefix *=.*|prefix=$$GATEABS|" \
	    -e "s|^exec_prefix *=.*|exec_prefix=$$GATEABS|" \
	    -e "s|^libdir *=.*|libdir=$$GATEABS/lib|" \
	    -e "s|^sharedlibdir *=.*|sharedlibdir=$$GATEABS/lib|" \
	    -e "s|^includedir *=.*|includedir=$$GATEABS/include|" \
	    $(RUSTPC) > "$$GATE/pkgconfig/zlib.pc"; \
	for key in Libs Libs.private Cflags; do \
	  a=`sed -n "s/^$$key: *//p" $(RUSTPC)`; \
	  b=`sed -n "s/^$$key: *//p" "$$GATE/pkgconfig/zlib.pc"`; \
	  if test "$$a" != "$$b"; then \
	    echo "make rust-pc: the gate copy changed the $$key line, so it would not" >&2; \
	    echo 'make rust-pc: be exercising the descriptor that gets installed.' >&2; \
	    exit 1; \
	  fi; \
	done; \
	if ! command -v $(RUSTPKGCONFIG) > /dev/null 2>&1; then \
	  echo '		$(RUSTPKGCONFIG) is unavailable, so the static consumer was NOT'; \
	  echo '		linked.  The descriptor above was generated and its contents'; \
	  echo '		checked; what is untested is whether a consumer built from it'; \
	  echo '		links.  Install pkg-config, or name one:'; \
	  echo '		    make rust-pc RUSTPKGCONFIG=pkgconf'; \
	  echo '		*** zlib Rust pkg-config descriptor OK, consumer gate SKIPPED ***'; \
	  exit 0; \
	fi; \
	PKG_CONFIG_PATH="$$GATEABS/pkgconfig"; export PKG_CONFIG_PATH; \
	PKG_CONFIG_LIBDIR="$$GATEABS/pkgconfig"; export PKG_CONFIG_LIBDIR; \
	if ! $(RUSTPKGCONFIG) --exists zlib; then \
	  echo "make rust-pc: $(RUSTPKGCONFIG) cannot find the generated descriptor in" >&2; \
	  echo "make rust-pc: $$GATEABS/pkgconfig, so it is malformed." >&2; \
	  exit 1; \
	fi; \
	CF=`$(RUSTPKGCONFIG) --cflags zlib`; \
	LSTATIC=`$(RUSTPKGCONFIG) --static --libs zlib`; \
	LSHARED=`$(RUSTPKGCONFIG) --libs zlib`; \
	echo "		pkg-config --cflags zlib        -> $$CF"; \
	echo "		pkg-config --libs zlib          -> $$LSHARED"; \
	echo "		pkg-config --static --libs zlib -> $$LSTATIC"; \
	for lib in $$PRIVATE; do \
	  case " $$LSTATIC " in \
	    *" $$lib "*) ;; \
	    *) echo "make rust-pc: pkg-config --static --libs does not answer $$lib," >&2; \
	       echo 'make rust-pc: although the descriptor advertises it.' >&2; \
	       exit 1;; \
	  esac; \
	  case " $$LSHARED " in \
	    *" $$lib "*) \
	       echo "make rust-pc: pkg-config --libs answers $$lib, and it must not:" >&2; \
	       echo 'make rust-pc: dynamic consumption needs nothing but -lz, and a' >&2; \
	       echo 'make rust-pc: private library in the public answer over-links every' >&2; \
	       echo 'make rust-pc: dynamic consumer.  Libs.private is the right key.' >&2; \
	       exit 1;; \
	    *) ;; \
	  esac; \
	done; \
	echo '		every private library is in the static answer and none of them'; \
	echo '		is in the dynamic one'; \
	printf '%s\n' \
	  '/* Generated by `make rust-pc'"'"'.  A pkg-config consumer of the STAGED' \
	  '   Rust library, compiled with the flags pkg-config answers and nothing' \
	  '   else, and linked statically because that is the case the descriptor' \
	  '   this program exists to check is the only one that differs.  */' \
	  '#include <stdio.h>' \
	  '#include <string.h>' \
	  '#include "zlib.h"' \
	  '' \
	  'static const char payload[] =' \
	  '    "pkg-config static consumer: hello, hello!  hello, hello!  hello!";' \
	  '' \
	  'int main(int argc, char **argv)' \
	  '{' \
	  '    Bytef packed[256];' \
	  '    Bytef plain[256];' \
	  '    char line[64];' \
	  '    uLongf packed_len = (uLongf)sizeof packed;' \
	  '    uLongf plain_len = (uLongf)sizeof plain;' \
	  '    uLong crc;' \
	  '    gzFile gz;' \
	  '    int c;' \
	  '' \
	  '    if (argc < 2) {' \
	  '        fprintf(stderr, "usage: consumer <gzfile>\n");' \
	  '        return 1;' \
	  '    }' \
	  '    if (strcmp(zlibVersion(), ZLIB_VERSION) != 0) {' \
	  '        fprintf(stderr, "zlibVersion() is %s, not %s\n",' \
	  '                zlibVersion(), ZLIB_VERSION);' \
	  '        return 2;' \
	  '    }' \
	  '    if (compress2(packed, &packed_len, (const Bytef *)payload,' \
	  '                  (uLong)sizeof payload, 9) != Z_OK) {' \
	  '        fprintf(stderr, "compress2 failed\n");' \
	  '        return 3;' \
	  '    }' \
	  '    if (uncompress(plain, &plain_len, packed, packed_len) != Z_OK ||' \
	  '        plain_len != (uLongf)sizeof payload ||' \
	  '        memcmp(plain, payload, sizeof payload) != 0) {' \
	  '        fprintf(stderr, "round trip failed\n");' \
	  '        return 4;' \
	  '    }' \
	  '    crc = crc32(0L, (const Bytef *)payload, (uInt)sizeof payload);' \
	  '    if (crc != crc32_z(0L, (const Bytef *)payload, sizeof payload)) {' \
	  '        fprintf(stderr, "crc32 and crc32_z disagree\n");' \
	  '        return 5;' \
	  '    }' \
	  '    gz = gzopen(argv[1], "wb9");' \
	  '    if (gz == NULL || gzprintf(gz, "%s %d\n", "gz", 42) <= 0 ||' \
	  '        gzclose(gz) != Z_OK) {' \
	  '        fprintf(stderr, "gz write failed\n");' \
	  '        return 6;' \
	  '    }' \
	  '    gz = gzopen(argv[1], "rb");' \
	  '    if (gz == NULL) {' \
	  '        fprintf(stderr, "gz read open failed\n");' \
	  '        return 7;' \
	  '    }' \
	  '    c = gzgetc(gz);' \
	  '    if (c != 0x67 || gzgets(gz, line, (int)sizeof line) == NULL ||' \
	  '        strcmp(line, "z 42\n") != 0 || gzclose(gz) != Z_OK) {' \
	  '        fprintf(stderr, "gz read failed: first byte %d, line %s\n", c, line);' \
	  '        return 8;' \
	  '    }' \
	  '    printf("static pkg-config consumer OK: zlib %s, %lu -> %lu bytes,"' \
	  '           " crc32 %08lx, gzgetc read the gzFile_s prefix\n",' \
	  '           zlibVersion(), (unsigned long)sizeof payload,' \
	  '           (unsigned long)packed_len, (unsigned long)crc);' \
	  '    return 0;' \
	  '}' \
	  > "$$GATE/consumer.c"; \
	echo "$(CC) $(CFLAGS) $$CF -o $$GATE/consumer$(EXE) $$GATE/consumer.c $(LDFLAGS) $$LSTATIC"; \
	$(CC) $(CFLAGS) $$CF -o "$$GATE/consumer$(EXE)" "$$GATE/consumer.c" \
	  $(LDFLAGS) $$LSTATIC; \
	if command -v ldd > /dev/null 2>&1; then \
	  ldd "$$GATE/consumer$(EXE)" > "$$GATE/consumer.ldd" 2>&1 || true; \
	  if grep -i libz "$$GATE/consumer.ldd" > /dev/null 2>&1; then \
	    grep -i libz "$$GATE/consumer.ldd" >&2; \
	    echo 'make rust-pc: the consumer has a dynamic libz dependency, so it did' >&2; \
	    echo 'make rust-pc: not static-link the staged archive and this gate would' >&2; \
	    echo 'make rust-pc: be measuring some other library.' >&2; \
	    exit 1; \
	  fi; \
	  echo "		ldd: no dynamic libz, so -lz resolved to the staged $(STATICLIB)"; \
	else \
	  echo '		no ldd, cannot confirm the link was static; the gate directory'; \
	  echo '		holds no shared library, so -lz had nothing else to resolve to'; \
	fi; \
	OUT=`${QEMU_RUN} "$$GATE/consumer$(EXE)" "$$GATE/gate.gz"`; \
	rm -f "$$GATE/gate.gz"; \
	echo "		$$OUT"; \
	case "$$OUT" in \
	  *"static pkg-config consumer OK"*) ;; \
	  *) echo 'make rust-pc: the consumer ran but did not report success.' >&2; \
	     exit 1;; \
	esac; \
	echo '		*** zlib Rust pkg-config descriptor OK ***'


# Run the Rust test suites, then verify the exported ABI of the staged library,
# then the check that actually proves drop-in compatibility: compile the
# UNMODIFIED test/example.c and test/minigzip.c, their #include "zlib.h"
# untouched, against the staged Rust library and run them.  ldd then has to
# show the staged library bound rather than the system one, which is the only
# way to tell the two apart.  The compiler runs before LD_LIBRARY_PATH is
# redirected, so that $(CC) itself cannot end up loading the library under
# test, and each loader search path is extended with ${...:+...} so that no
# empty component is left behind -- a trailing colon would put the build
# directory, where the C library's own libz.so.1 lives, on the path.
#
# THE ABI VERIFICATION IS NOT HERE ANY MORE.  It lives in `rust', which make
# runs as a prerequisite of this target, and it runs there unconditionally --
# see the five numbered checks in the comment above that recipe.  It was moved
# for a reason this target demonstrated: it had its own spelling of the staged
# library's name and its own copy of the comparisons, the two spellings drifted,
# and the result was a green run that had linked the C drivers against
# $(STATICLIB) without ever loading the shared object.  One implementation, one
# name, one place to read the staged name from ($(RUSTLIBDIR)/soname.stage,
# written by `rust').
#
# What this target refuses to do now is substitute the static library for a
# missing shared one.  If a shared library was wanted and is not there, it fails
# and says so, because the shared object is the artifact a consumer actually
# loads.
#
# Everything below reads the STAGED library, never $(RUSTDIR).  The `cargo test'
# above rebuilds the workspace with the test profile and default features, so
# it can replace $(RUSTDIR)/$(STATICLIB) and $(RUSTDIR)/$(SHAREDLIB) while this
# target runs.  `rust' copies the archive into place and relinks from that copy
# for the same reason: what is verified here has to be the same bytes that get
# installed, and only the staged copy is stable.
#
# $(RUSTRUNTIMESYMS) explains itself here as well as in the variable block:
# rust_eh_personality is the Rust language runtime's unwinder personality
# routine.  libstd defines it inside $(STATICLIB), it does not match zlib.map's
# `_*' pattern, and zlib.map is immutable, so it cannot be hidden.  Hiding it
# with a second version script would add a seventeenth version node this library
# has never had, which is worse than the leak -- consumers resolve against node
# names, and inventing one is an ABI addition.  It is therefore excluded from the
# export comparison by enumerated name rather than by pattern, so that a second
# leaked symbol cannot hide behind it.
# The verification sequence runs as a standalone subshell whose status is
# captured, deliberately not as the condition of the `if' below: a shell
# ignores `set -e' inside an `if' condition, so written that way a failing
# cargo test or a failing compile would be reported as a pass.
#
# ZLIB_RS_SIMD is honoured here too, so the suites exercise the same checksum
# backends the staged library was built with; the tests are what would catch an
# alternative backend that failed to be output neutral.  This selection is
# spelled with the `<package>/<feature>' form because CARGO_TEST_FLAGS is
# --workspace, and the contradiction check lives in `rust', which make has
# already run as a prerequisite by the time this recipe starts.
#
# WHAT THIS TARGET DOES AND DOES NOT ESTABLISH.  Passing it is necessary for the
# drop-in claim and is not sufficient for it.  Beyond `cargo test' and the five
# checks `rust' already made it compiles and runs the UNMODIFIED test/example.c and
# test/minigzip.c against the staged shared library -- their #include "zlib.h"
# untouched, with `ldd' proving the staged library was the one bound rather than
# the system one -- and the UNMODIFIED test/infcover.c against the staged
# $(STATICLIB).  infcover is the most demanding of the three: its instrumented
# allocator fills every block with 0xa5 rather than zero, so it catches any code
# path that assumes zero-initialised memory, and its mem_done() detects leaks,
# non-LIFO frees and rogue frees through the injected zalloc/zfree hooks.  It is
# linked against the archive rather than the shared library on purpose, because it
# includes inflate.h and inftrees.h and calls inflate_table() directly, so it
# needs a symbol the version script keeps out of the shared library's exports.
#
# PACKAGE METADATA IS COVERED, by prerequisite rather than by this recipe.
# `rust-pc' is the second prerequisite, so a green `rust-test' also means the
# pkg-config descriptor for the staged library was generated and a C consumer was
# compiled from nothing but the flags that descriptor answers, linked against the
# staged $(STATICLIB) and run.  That is the one packaging property where the two
# implementations genuinely differ -- a Rust staticlib needs the Rust runtime's
# native libraries on the link line and the C one needs nothing -- so it is
# checked here rather than left to whoever installs the result.
#
# NOT COVERED HERE, and therefore still open: byte-identical compressed output
# against the C encoder (the differential harness), Miri, the sanitizers, the
# fuzz budget, and the throughput gates.  Do not read a green `rust-test' as
# evidence for any of those.  The cbindgen header diff is no longer on that list:
# `make rust-header' performs it, and its own comment says which parts of the
# comparison it does and does not implement.
rust-test: rust rust-pc
	@if test -z "$(CARGO)"; then \
	  echo 'make rust-test: no Rust toolchain -- $$(CARGO) is empty' >&2; \
	  echo 'make rust-test: install cargo, then re-run ./configure, or name it:' >&2; \
	  echo 'make rust-test:     make rust-test CARGO=cargo' >&2; \
	  exit 1; \
	fi; \
	SRCROOT=`cd "$(SRCDIR)." && pwd`; \
	RUSTLIB=`pwd`/$(RUSTLIBDIR); \
	( set -e; \
	  $(RUSTPATHGUARD); \
	  TEST_FEATURES=''; \
	  case "$${ZLIB_RS_SIMD-}" in \
	    ''|0) ;; \
	    1) TEST_FEATURES='--features zlib-rs/simd,libz-rs-sys/simd';; \
	    *) echo "ZLIB_RS_SIMD must be 0 or 1, got \"$${ZLIB_RS_SIMD}\""; exit 1;; \
	  esac; \
	  CARGO_TARGET_DIR='$(RUSTTARGETDIR)'; export CARGO_TARGET_DIR; \
	  echo "$(CARGO) test $(CARGO_TEST_FLAGS) $$TEST_FEATURES"; \
	  $(CARGO) test $(CARGO_TEST_FLAGS) --manifest-path "$$SRCROOT/Cargo.toml" \
	    $$TEST_FEATURES; \
	  SOV=`sed -n 1p "$$RUSTLIB/soname.stage"`; \
	  SOM=`sed -n 2p "$$RUSTLIB/soname.stage"`; \
	  VSMODE=`sed -n 3p "$$RUSTLIB/soname.stage"`; \
	  NSL=`cat "$$RUSTLIB/native-static-libs.stage" 2>/dev/null || :`; \
	  if test "$$VSMODE" = static; then \
	    echo "make rust-test: configured --static, so the C drivers link $(STATICLIB)"; \
	    ZLINK="$$RUSTLIB/$(STATICLIB)"; DYNAMIC=0; \
	  elif test -f "$$RUSTLIB/$$SOV"; then \
	    ZLINK="-L$$RUSTLIB -lz -Wl,-rpath,$$RUSTLIB"; DYNAMIC=1; \
	  else \
	    echo "make rust-test: $$RUSTLIB/$$SOV is missing, although a shared library" >&2; \
	    echo "make rust-test: was wanted.  Linking the C drivers against $(STATICLIB)" >&2; \
	    echo "make rust-test: instead would leave the shared object -- the artifact a" >&2; \
	    echo "make rust-test: consumer actually loads -- untested, and report success." >&2; \
	    echo "make rust-test: Run \`make rust' and fix what it reports." >&2; \
	    exit 1; \
	  fi; \
	  echo "make rust-test: the exported-symbol comparisons ran in \`rust', which make"; \
	  echo "make rust-test: has already completed as a prerequisite of this target"; \
	  if test -z "$$NSL"; then \
	    echo "make rust-test: $$RUSTLIB/native-static-libs.stage names no native" >&2; \
	    echo "make rust-test: libraries, so the static links below would be composed" >&2; \
	    echo "make rust-test: from an unknown requirement set.  \`make rust' records" >&2; \
	    echo "make rust-test: the set it probed there; an empty file means it could" >&2; \
	    echo "make rust-test: not ask $(RUSTC).  A link that happens to succeed on" >&2; \
	    echo "make rust-test: this libc proves nothing about the archive published" >&2; \
	    echo "make rust-test: for consumers, so this stops instead:" >&2; \
	    echo "make rust-test:     make rust rust-test RUSTC=/path/to/rustc" >&2; \
	    echo "make rust-test:     make rust rust-test RUSTPCPRIVATE=\"-lm -lpthread -lc\"" >&2; \
	    exit 1; \
	  fi; \
	  echo "make rust-test: static links additionally carry $$NSL"; \
	  echo "make rust-test: (from $$RUSTLIB/native-static-libs.stage, which \`make rust'"; \
	  echo "make rust-test: probed for this target -- the archive carries the Rust"; \
	  echo "make rust-test: runtime and cannot record them itself)"; \
	  case "$$DYNAMIC" in \
	    0) ZLINK="$$ZLINK $$NSL" ;; \
	  esac; \
	  $(CC) $(CFLAGS) $(ZINCOUT) -o "$$RUSTLIB/examplerust$(EXE)" \
	    "$$SRCROOT/test/example.c" $(LDFLAGS) $$ZLINK; \
	  $(CC) $(CFLAGS) $(ZINCOUT) -o "$$RUSTLIB/minigziprust$(EXE)" \
	    "$$SRCROOT/test/minigzip.c" $(LDFLAGS) $$ZLINK; \
	  $(CC) $(CFLAGS) $(ZINCOUT) -o "$$RUSTLIB/infcoverrust$(EXE)" \
	    "$$SRCROOT/test/infcover.c" $(LDFLAGS) "$$RUSTLIB/$(STATICLIB)" $$NSL; \
	  if test $$DYNAMIC -eq 1; then \
	    LD_LIBRARY_PATH=$$RUSTLIB$${LD_LIBRARY_PATH:+:$$LD_LIBRARY_PATH}; \
	    export LD_LIBRARY_PATH; \
	    DYLD_LIBRARY_PATH=$$RUSTLIB$${DYLD_LIBRARY_PATH:+:$$DYLD_LIBRARY_PATH}; \
	    export DYLD_LIBRARY_PATH; \
	    SHLIB_PATH=$$RUSTLIB$${SHLIB_PATH:+:$$SHLIB_PATH}; \
	    export SHLIB_PATH; \
	    if command -v ldd > /dev/null 2>&1; then \
	      ldd "$$RUSTLIB/examplerust$(EXE)" > "$$RUSTLIB/ldd.log" 2>&1; \
	      grep libz "$$RUSTLIB/ldd.log" || true; \
	      BOUND=`awk -v want="$$SOM" '$$1 == want && $$2 == "=>" { print $$3; exit }' \
	        "$$RUSTLIB/ldd.log"`; \
	      if test -z "$$BOUND"; then \
	        echo "make rust-test: examplerust has no dynamic dependency on $$SOM at" >&2; \
	        echo "make rust-test: all, so the loader was never asked for the staged" >&2; \
	        echo "make rust-test: library and nothing under test was exercised." >&2; \
	        exit 1; \
	      fi; \
	      if test "$$BOUND" != "$$RUSTLIB/$$SOM"; then \
	        echo "make rust-test: $$SOM resolved to $$BOUND rather than to the staged" >&2; \
	        echo "make rust-test: $$RUSTLIB/$$SOM.  That is almost always the SYSTEM" >&2; \
	        echo "make rust-test: zlib: the library declares SONAME $$SOM, so the loader" >&2; \
	        echo "make rust-test: searches for that name, and when it is not in the" >&2; \
	        echo "make rust-test: staging directory every driver passes against a" >&2; \
	        echo "make rust-test: library this build did not produce." >&2; \
	        exit 1; \
	      fi; \
	      echo "make rust-test: ldd confirms $$SOM bound from $$RUSTLIB"; \
	    else \
	      echo 'warning: no ldd, cannot confirm which libz was bound'; \
	    fi; \
	  fi; \
	  echo hello world | ${QEMU_RUN} "$$RUSTLIB/minigziprust$(EXE)" | \
	    ${QEMU_RUN} "$$RUSTLIB/minigziprust$(EXE)" -d; \
	  ${QEMU_RUN} "$$RUSTLIB/examplerust$(EXE)" "$$RUSTLIB/tmprust.gz"; \
	  rm -f "$$RUSTLIB/tmprust.gz"; \
	  ${QEMU_RUN} "$$RUSTLIB/infcoverrust$(EXE)"; \
	); rc=$$?; \
	if test $$rc -eq 0; then \
	  echo '		*** zlib Rust test OK ***'; \
	else \
	  echo '		*** zlib Rust test FAILED ***'; false; \
	fi

# Compare the staged Rust library's exported symbol set against the C reference
# library's, name for name, and print the difference in both directions.
#
# This is the C-VERSUS-RUST comparison, and it is a different question from the
# one `rust' answers.  `rust' compares the staged library against the two
# immutable contract files, $(SRCDIR)zlib.h and $(SRCDIR)zlib.map, which is what
# can be done anywhere and is therefore mandatory there.  This target compares it
# against a BUILT C library ($(ZLIBREF), overridable), which needs one to exist
# and in exchange catches anything both implementations would have to agree on
# but the contract files do not spell out.  Measured here: 111 symbols on each
# side, identical.
#
# `rust' performs the same diff as its fifth check when $(ZLIBREF) happens to
# exist, so this target is the way to demand it rather than the only place it can
# happen.
rust-symbols: rust
	@if test -z "$(CARGO)"; then \
	  echo 'make rust-symbols: no Rust toolchain -- $$(CARGO) is empty' >&2; \
	  echo 'make rust-symbols: install cargo, then re-run ./configure, or name it:' >&2; \
	  echo 'make rust-symbols:     make rust-symbols CARGO=cargo' >&2; \
	  exit 1; \
	fi; \
	SOV=`sed -n 1p $(RUSTLIBDIR)/soname.stage`; \
	VSMODE=`sed -n 3p $(RUSTLIBDIR)/soname.stage`; \
	if test "$$VSMODE" = static; then \
	  echo 'make rust-symbols: configured --static, so there is no shared library to' >&2; \
	  echo 'make rust-symbols: compare.  The export set of the staged $(STATICLIB) is' >&2; \
	  echo 'make rust-symbols: checked by `rust'\'' itself; this target needs a shared' >&2; \
	  echo 'make rust-symbols: object on both sides.' >&2; \
	  exit 1; \
	fi; \
	if test ! -f "$(RUSTLIBDIR)/$$SOV"; then \
	  echo "make rust-symbols: $(RUSTLIBDIR)/$$SOV does not exist" >&2; \
	  exit 1; \
	fi; \
	if ! command -v $(RUSTNM) > /dev/null 2>&1; then \
	  echo "$(RUSTNM) is unavailable, so the symbol sets cannot be compared" >&2; \
	  exit 1; \
	fi; \
	if test ! -f $(ZLIBREF); then \
	  echo "the C reference library $(ZLIBREF) does not exist." >&2; \
	  echo "Build it with 'make $(SHAREDLIBV)', or point ZLIBREF at a copy:" >&2; \
	  echo "    make rust-symbols ZLIBREF=/path/to/$$SOV" >&2; \
	  exit 1; \
	fi; \
	set -e; \
	$(RUSTNM) -D --defined-only --extern-only $(ZLIBREF) \
	  | awk '{ print $$NF }' | sort > c.syms; \
	$(RUSTNM) -D --defined-only --extern-only "$(RUSTLIBDIR)/$$SOV" \
	  | awk '{ print $$NF }' | sort > rust.syms; \
	echo "C   $(ZLIBREF): `wc -l < c.syms` symbols"; \
	echo "Rust $(RUSTLIBDIR)/$$SOV: `wc -l < rust.syms` symbols"; \
	if diff -u c.syms rust.syms > /dev/null 2>&1; then \
	  echo '		*** zlib Rust symbol parity OK ***'; \
	else \
	  comm -23 c.syms rust.syms > missing.syms; \
	  comm -13 c.syms rust.syms > extra.syms; \
	  if test -s missing.syms; then \
	    echo "MISSING from the Rust library (`wc -l < missing.syms`):"; \
	    sed 's/^/    /' missing.syms; \
	  fi; \
	  if test -s extra.syms; then \
	    echo "EXTRA in the Rust library (`wc -l < extra.syms`):"; \
	    sed 's/^/    /' extra.syms; \
	  fi; \
	  rm -f missing.syms extra.syms; \
	  echo '		*** zlib Rust symbol parity FAILED ***'; \
	  false; \
	fi

# The header gate.  Regenerate the C header from the Rust facade with cbindgen
# and hold the artifact to three checks, in this order:
#
#   1. GENERATOR OUTPUT.  Every line cbindgen writes to stderr has to match
#      $(RUSTHEADERWARNOK), the enumerated allowance.  A warning there means
#      cbindgen could not resolve an item, and an item it could not resolve is
#      an item this gate cannot have compared -- so an unexplained warning is a
#      hole in the gate, not cosmetic noise.  Measured, in the order the holes
#      were closed: 269 lines before any of the cbindgen:ignore annotations,
#      then 57 once the layout_assertions module and the anonymous const _
#      items were annotated, then 8 once the named private constants were, then
#      2 -- which is where the allowance is drawn -- and 0 today, once the
#      annotation reached the rest of the crate's private constants, the
#      remaining anonymous const _ items, the two published allocator hooks, the
#      DeflateStateC alias and the imported-from-libc extern block.
#   2. THE ARTIFACT IS VALID C, AND VALID C++.  Compile it standalone in every
#      $(RUSTHEADERCSTDS) dialect and every $(RUSTHEADERCXXSTDS) dialect, with
#      -Wall -Wextra -pedantic and warnings fatal.  This is the check that
#      would have caught the two defects this gate was built after: a doc
#      comment containing a block-comment terminator, which closed cbindgen's
#      comment early and left prose to be lexed as code, and an apostrophe in
#      the prose that followed it, which gcc read as an unterminated character
#      constant.  Neither is visible in the Rust source and neither stops
#      cbindgen from exiting 0.  -Wall covers the other half of that class as
#      well: a doc comment containing a block-comment OPENER draws
#      -Werror=comment here (measured), so neither sequence can reach a doc
#      comment on an emitted item unnoticed.
#   3. THE DECLARED FUNCTION SET, IN BOTH DIRECTIONS.  Compare the names the
#      artifact declares against the names zlib.h declares with ZEXTERN, and
#      require the difference to be within the two enumerated allowances
#      $(RUSTHEADERNOGEN) and $(RUSTHEADEREXTRAOK).  Both directions matter and
#      for different reasons: a name only zlib.h has is a hole in the port, and
#      a name only the artifact has is an internal escaping into a file that
#      looks exactly like the public contract.  An allowance that is no longer
#      exercised is reported too, so the lists cannot quietly outlive their
#      reasons.
#
# WHAT THIS TARGET DOES NOT DO, because a gate that is believed to check more
# than it does is worse than no gate:
#   * It never opens a built library, so it cannot tell whether any of these
#     names is actually EXPORTED.  That is what `rust' and `rust-test' do with
#     nm, and it is why gzprintf and gzvprintf can be an allowance here while
#     remaining a hard requirement there.
#   * It compares NAMES, not signatures, parameter types, struct layouts or
#     macro values.  The rest of the normalisation -- rules A3, A4, A6, A7, A8,
#     rule 10 and rule A11, spelled out under "NORMALISATION RULES THE GATE
#     MUST IMPLEMENT" in $(SRCDIR)cbindgen.toml -- belongs to the
#     header-conformance job of .github/workflows/rust.yml, which runs this
#     target first and then re-declares every generated prototype against
#     $(SRCDIR)zlib.h so the compiler itself reports a conflicting type, and
#     diffs a compiler-resolved rendering of all 95 contract signatures against
#     the same rendering of $(SRCDIR)zlib.h's with an EMPTY diff required.  What
#     is here is the part that is mechanical in make and catches the whole
#     class of defect that made the header unusable; it is not the whole of
#     Pass A.
#   * It needs no built library and no `rust' run, so it is not a prerequisite
#     of anything and nothing is a prerequisite of it.
#
# WHAT IS AUTOMATED HERE, AND WHAT IS DELIBERATELY NOT.  The boundary is worth
# stating outright, because "the checks exist" and "the checks are automated"
# are different claims and a reader is entitled to know which one each item is:
#
#   AUTOMATED BY THIS FILE, and each proven to FAIL when its property is
#   violated rather than merely to pass today:
#     - the generated header compiles as C89, C99, C17 and C++17, under the
#       host configuration AND under each of $(RUSTHEADERTARGETS).  The target
#       variant is not decoration: cbindgen renders cfg(windows) items inside
#       `#if defined(_WIN32)', so without it the header's Windows half is never
#       preprocessed in and a wchar_t typedef emitted there compiles clean in
#       every dialect.  Measured both ways.
#     - cbindgen's stderr carries nothing outside $(RUSTHEADERWARNOK).
#     - every function $(SRCDIR)zlib.h declares is exported by the staged
#       library, and nothing else is (`rust', two-way set diff).
#     - that set is exactly $(RUSTPUBLICFNS) functions, and the artifact carries
#       exactly $(RUSTVERNODES) version nodes.  These pin the frozen contract
#       itself; the set diffs above them compare two DERIVED sides and so move
#       together when the contract moves.
#     - none of $(SRCDIR)zlib.map's `local:' names is exported, the node set
#       matches the map, and the SONAME is the derived one.
#     - the unmodified test/example.c, test/minigzip.c and test/infcover.c link
#       against the staged library and pass, with ldd confirming which library
#       was bound (`rust-test').
#
#   NOT AUTOMATED HERE, and left to .github/workflows/rust.yml by scope.  Each of
#   these IS automated there, in the job named:
#     - the SHAPE half of the normalisation rules -- A3, A4, A6, A7, A8, rule 10
#       and rule A11's literal signature diff -- which need a C and a C++
#       compiler and a probe program rather than sed.  The `header' job owns
#       them, and runs this target first; `rust-header' owns A1, A2, A5 and A9.
#     - BUILDS of the facade on another platform.  This file gates the generated
#       header under -D_WIN32, which is a header check, not a build.  The
#       `build-test' job builds and tests the workspace natively on
#       `macos-latest' and `windows-latest' as well as Ubuntu.  What remains
#       unautomated anywhere is CROSS-compilation: `cargo clippy --target
#       x86_64-pc-windows-gnu' or an i686 triple wants a matrix row nothing
#       carries, and cross-LINKING for Windows wants a cross-linker this tree
#       does not assume.
#     - Miri, AddressSanitizer, cargo-fuzz and the criterion throughput gates,
#       all of which need a nightly toolchain or a time budget a build target
#       must not impose.
rust-header:
	@set -e; \
	srcroot=`cd "$(SRCDIR)." && pwd`; \
	if ! command -v $(RUSTCBINDGEN) > /dev/null 2>&1; then \
	  echo 'make rust-header: $(RUSTCBINDGEN) is unavailable, so the generated' >&2; \
	  echo 'make rust-header: header cannot be produced and the gate cannot run.' >&2; \
	  echo 'make rust-header: install the pinned version:' >&2; \
	  echo 'make rust-header:     cargo install cbindgen --locked --version 0.29.4' >&2; \
	  echo 'make rust-header: or name another one:' >&2; \
	  echo 'make rust-header:     make rust-header RUSTCBINDGEN=/path/to/cbindgen' >&2; \
	  exit 1; \
	fi; \
	if ! command -v cargo > /dev/null 2>&1; then \
	  echo 'make rust-header: no cargo on PATH.  cbindgen resolves --crate' >&2; \
	  echo 'make rust-header: through cargo metadata, so it needs one even' >&2; \
	  echo 'make rust-header: though this target builds nothing.' >&2; \
	  exit 1; \
	fi; \
	rm -f '$(RUSTHEADER)' $(RUSTHEADERSCRATCH); \
	echo "$(RUSTCBINDGEN) --config cbindgen.toml --crate libz-rs-sys --output $(RUSTHEADER)"; \
	if ! $(RUSTCBINDGEN) --config "$$srcroot/cbindgen.toml" --crate libz-rs-sys \
	     --output '$(RUSTHEADER)' "$$srcroot" 2> '$(RUSTHEADER).warn'; then \
	  sed 's/^/    /' '$(RUSTHEADER).warn' >&2; \
	  echo 'make rust-header: cbindgen failed; no artifact to check' >&2; \
	  exit 1; \
	fi; \
	if test ! -s '$(RUSTHEADER)'; then \
	  echo 'make rust-header: cbindgen wrote no header' >&2; \
	  exit 1; \
	fi; \
	unexpected=`grep -v -E '$(RUSTHEADERWARNOK)' '$(RUSTHEADER).warn' || true`; \
	if test -n "$$unexpected"; then \
	  echo 'make rust-header: cbindgen wrote output outside the allowance:' >&2; \
	  printf '%s\n' "$$unexpected" | sed 's/^/    /' >&2; \
	  echo 'make rust-header: every one is an item cbindgen could not resolve,' >&2; \
	  echo 'make rust-header: and so an item this gate did not compare.  Fix the' >&2; \
	  echo 'make rust-header: item, or widen RUSTHEADERWARNOK with a reason.' >&2; \
	  exit 1; \
	fi; \
	allowed=`grep -c -E '$(RUSTHEADERWARNOK)' '$(RUSTHEADER).warn' || true`; \
	echo "	cbindgen: $$allowed allowed notice(s), 0 unexpected"; \
	echo 'int zrs_probe;' > '$(RUSTHEADER).probe.c'; \
	cran=0; cxxran=0; \
	for std in $(RUSTHEADERCSTDS); do \
	  relax=; \
	  case "$$std" in c89) relax='$(RUSTHEADERC89FLAGS)' ;; esac; \
	  if ! $(CC) -std=$$std -fsyntax-only '$(RUSTHEADER).probe.c' \
	       > '$(RUSTHEADER).log' 2>&1; then \
	    echo "	C   -std=$$std: SKIPPED, $(CC) does not accept it"; \
	    continue; \
	  fi; \
	  for tgt in host $(RUSTHEADERTARGETS); do \
	    case "$$tgt" in \
	      host) tdef=; tname=;; \
	      *) tdef=-D$$tgt; tname=" -D$$tgt";; \
	    esac; \
	    if $(CC) -std=$$std $(RUSTHEADERDEFS) $$tdef -Wall -Wextra -pedantic -Werror \
	       $$relax -fsyntax-only -x c '$(RUSTHEADER)' > '$(RUSTHEADER).log' 2>&1; then \
	      cran=`expr $$cran + 1`; \
	      echo "	C   -std=$$std$$tname: clean$${relax:+ (with $$relax, see D9)}"; \
	    else \
	      sed 's/^/    /' '$(RUSTHEADER).log' >&2; \
	      echo "make rust-header: $(RUSTHEADER) is not valid C at -std=$$std$$tname" >&2; \
	      exit 1; \
	    fi; \
	  done; \
	done; \
	for std in $(RUSTHEADERCXXSTDS); do \
	  if ! $(RUSTHEADERCXX) -std=$$std -fsyntax-only -x c++ \
	       '$(RUSTHEADER).probe.c' > '$(RUSTHEADER).log' 2>&1; then \
	    echo "	C++ -std=$$std: SKIPPED, $(RUSTHEADERCXX) does not accept it"; \
	    continue; \
	  fi; \
	  for tgt in host $(RUSTHEADERTARGETS); do \
	    case "$$tgt" in \
	      host) tdef=; tname=;; \
	      *) tdef=-D$$tgt; tname=" -D$$tgt";; \
	    esac; \
	    if $(RUSTHEADERCXX) -std=$$std $(RUSTHEADERDEFS) $$tdef -Wall -Wextra -pedantic \
	       -Werror -fsyntax-only -x c++ '$(RUSTHEADER)' \
	       > '$(RUSTHEADER).log' 2>&1; then \
	      cxxran=`expr $$cxxran + 1`; \
	      echo "	C++ -std=$$std$$tname: clean"; \
	    else \
	      sed 's/^/    /' '$(RUSTHEADER).log' >&2; \
	      echo "make rust-header: $(RUSTHEADER) is not valid C++ at -std=$$std$$tname" >&2; \
	      exit 1; \
	    fi; \
	  done; \
	done; \
	if test $$cran -eq 0; then \
	  echo "make rust-header: no C dialect could be compiled, so the artifact" >&2; \
	  echo "make rust-header: was never checked.  Name a dialect $(CC) accepts:" >&2; \
	  echo "make rust-header:     make rust-header RUSTHEADERCSTDS=gnu99" >&2; \
	  exit 1; \
	fi; \
	if test $$cxxran -eq 0; then \
	  echo "make rust-header: no C++ dialect could be compiled, so the" >&2; \
	  echo "make rust-header: extern \"C\" bracket every C++ consumer needs was" >&2; \
	  echo "make rust-header: never checked.  Name a compiler and dialect:" >&2; \
	  echo "make rust-header:     make rust-header RUSTHEADERCXX=clang++" >&2; \
	  exit 1; \
	fi; \
	skip=; for n in $(RUSTMACROFN); do skip="$$skip -e $$n"; done; \
	tr '\n' ' ' < "$$srcroot/zlib.h" | sed 's/ZEXTERNVA/ZEXTERN/g' | tr ';' '\n' \
	  | grep ZEXTERN \
	  | sed -n 's/.*[ *]\([A-Za-z_][A-Za-z0-9_]*\)[ ]*(.*/\1/p' \
	  | sort -u | grep -v -x $$skip > '$(RUSTHEADER).ref'; \
	$(CC) -E $(RUSTHEADERDEFS) -x c '$(RUSTHEADER)' \
	  | awk -v hdr='$(RUSTHEADER)' \
	      '/^#[ ]+[0-9]+[ ]+"/ { keep = ($$3 == "\"" hdr "\"") ? 1 : 0; next } \
	       keep { print }' \
	  | tr '\n' ' ' | tr ';' '\n' | grep -v typedef \
	  | sed -n 's/^[^(]*[ *]\([A-Za-z_][A-Za-z0-9_]*\)[ ]*(.*/\1/p' \
	  | sort -u > '$(RUSTHEADER).gen'; \
	echo "	zlib.h declares `wc -l < '$(RUSTHEADER).ref'` contract functions;"; \
	echo "	$(RUSTHEADER) declares `wc -l < '$(RUSTHEADER).gen'`"; \
	missing=`comm -23 '$(RUSTHEADER).ref' '$(RUSTHEADER).gen' | tr '\n' ' '`; \
	extra=`comm -13 '$(RUSTHEADER).ref' '$(RUSTHEADER).gen' | tr '\n' ' '`; \
	rc=0; \
	for n in $$missing; do \
	  ok=0; \
	  for a in $(RUSTHEADERNOGEN); do test "$$n" = "$$a" && ok=1; done; \
	  if test $$ok -eq 1; then \
	    echo "	missing, allowed by RUSTHEADERNOGEN: $$n"; \
	  else \
	    echo "make rust-header: zlib.h declares $$n and $(RUSTHEADER) does not." >&2; \
	    rc=1; \
	  fi; \
	done; \
	for n in $$extra; do \
	  ok=0; \
	  for a in $(RUSTHEADEREXTRAOK); do test "$$n" = "$$a" && ok=1; done; \
	  if test $$ok -eq 1; then \
	    echo "	extra, allowed by RUSTHEADEREXTRAOK: $$n"; \
	  else \
	    echo "make rust-header: $(RUSTHEADER) declares $$n and zlib.h does not." >&2; \
	    echo "make rust-header: an internal must not reach a file whose guard is" >&2; \
	    echo "make rust-header: ZLIB_H.  Exclude it in cbindgen.toml, or add it to" >&2; \
	    echo "make rust-header: RUSTHEADEREXTRAOK with the reason it belongs." >&2; \
	    rc=1; \
	  fi; \
	done; \
	for a in $(RUSTHEADERNOGEN); do \
	  case " $$missing " in \
	    *" $$a "*) ;; \
	    *) echo "	notice: RUSTHEADERNOGEN lists $$a, which IS generated now --"; \
	       echo "	notice: drop it from the allowance and require the name" ;; \
	  esac; \
	done; \
	for a in $(RUSTHEADEREXTRAOK); do \
	  case " $$extra " in \
	    *" $$a "*) ;; \
	    *) echo "	notice: RUSTHEADEREXTRAOK lists $$a, which is not declared --"; \
	       echo "	notice: drop it from the allowance" ;; \
	  esac; \
	done; \
	if test $$rc -ne 0; then \
	  echo '		*** zlib Rust header gate FAILED ***'; \
	  exit 1; \
	fi; \
	rm -f $(RUSTHEADERSCRATCH); \
	echo '		*** zlib Rust header gate OK ***'

# Remove everything `rust', `rust-test' and `rust-header' produced: cargo's own
# output, and with it the packaged library, the relinked drivers and the symbol
# lists that all live under $(RUSTLIBDIR) inside $(RUSTTARGETDIR).  The names on
# the final `rm' are what is written into the build directory itself -- the
# generated header and its working files, plus the symbol lists `rust-symbols'
# reports from -- for which `.gitignore' also carries anchored rules.
# Check the two SHIPPED crates on the declared MSRV floor with warnings as errors.
#
# WHY THIS IS A SEPARATE GATE.  `rust' and `rust-test' use whatever cargo is on
# PATH, which is normally current stable, and a warning that only the floor
# compiler emits is therefore invisible to them.  That is not hypothetical: both
# `ZLIB_VER_MAJOR_DIGIT' and `FORBIDDEN_CONFIGURATION_BITS' in
# crates/libz-rs-sys/src/util.rs were once read only from anonymous
# `const _: () = assert!(...)' items, which Rust 1.80's dead-code pass does not
# count as uses while current stable's does -- so this check exited 101 on the
# declared floor while stable clippy was green.  Both constants are now folded
# into the initialisers of constants the exported functions read, and this target
# is what keeps that true.
#
#   RUSTMSRV     The floor toolchain, as a rustup toolchain name.  MUST equal
#                `rust-version' in the root Cargo.toml; if the two diverge, this
#                gate stops meaning anything.  clippy.toml deliberately declares
#                no `msrv' key -- clippy reads each package's own `rust-version'
#                instead, which is what keeps the excluded `benches' package, whose
#                floor is criterion's 1.86, from being judged against the shipped
#                crates' floor and vice versa -- so it is not a third place to
#                change.
#   RUSTMSRVFLAGS  RUSTFLAGS for the check.  `-D warnings' is the whole point of
#                the target, so overriding it to nothing defeats it.
#
# TWO SCOPES, and the first one used to be impossible.  `$(CARGO_MSRV_FLAGS)' names
# `-p zlib-rs -p libz-rs-sys --all-features --all-targets', because the feature
# matrix is a promise about the two crates that SHIP.  `$(CARGO_MSRV_WS_FLAGS)' adds
# `--locked --workspace --all-targets', which is a statement about the workspace
# itself: every member declares the same floor, so the floor compiler can resolve
# and check all three.  While the three criterion suites were attached to the
# differential harness as `[[bench]]' entries, criterion's own manifest -- and the
# edition-2024 clap manifests it reaches -- needed a newer cargo than 1.80, so
# `--workspace' could not even RESOLVE at the floor.  The suites now live in the
# excluded `benches' package with their own lock (see benches/Cargo.toml section 2),
# which is what makes the second scope meaningful; adding a criterion edge back to
# any member removes it again.
#
# It also writes to its own subdirectory of $(RUSTTARGETDIR).  Two compilers
# sharing one target directory is legal but makes each invalidate the other's
# fingerprints, so a stable build followed by this gate would rebuild the world
# twice; a separate directory keeps the warm stable cache warm.
#
# `+$(RUSTMSRV)' is a rustup argument.  When cargo is not rustup's shim, or the
# toolchain is not installed, the command fails and this recipe names the remedy
# rather than reporting a pass -- an MSRV gate that silently skips is worse than
# none, because the badge stays green.
rust-msrv:
	@if test -z "$(CARGO)"; then \
	  echo 'make rust-msrv: no Rust toolchain -- $$(CARGO) is empty' >&2; \
	  echo 'make rust-msrv: install cargo, then re-run ./configure, or name it:' >&2; \
	  echo 'make rust-msrv:     make rust-msrv CARGO=cargo' >&2; \
	  exit 1; \
	fi; \
	if ! $(CARGO) +$(RUSTMSRV) --version > /dev/null 2>&1; then \
	  echo 'make rust-msrv: the $(RUSTMSRV) toolchain is not available' >&2; \
	  echo 'make rust-msrv: install it with:' >&2; \
	  echo 'make rust-msrv:     rustup toolchain install $(RUSTMSRV) --profile minimal' >&2; \
	  exit 1; \
	fi; \
	SRCROOT=`cd "$(SRCDIR)." && pwd`; \
	( set -e; \
	  $(RUSTPATHGUARD); \
	  CARGO_TARGET_DIR='$(RUSTTARGETDIR)/msrv'; export CARGO_TARGET_DIR; \
	  RUSTFLAGS='$(RUSTMSRVFLAGS)'; export RUSTFLAGS; \
	  echo "$(CARGO) +$(RUSTMSRV) metadata --locked"; \
	  $(CARGO) +$(RUSTMSRV) metadata --locked --format-version 1 \
	    --manifest-path "$$SRCROOT/Cargo.toml" > /dev/null; \
	  echo "RUSTFLAGS='$(RUSTMSRVFLAGS)' $(CARGO) +$(RUSTMSRV) check $(CARGO_MSRV_WS_FLAGS)"; \
	  $(CARGO) +$(RUSTMSRV) check $(CARGO_MSRV_WS_FLAGS) \
	    --manifest-path "$$SRCROOT/Cargo.toml"; \
	  echo "RUSTFLAGS='$(RUSTMSRVFLAGS)' $(CARGO) +$(RUSTMSRV) check $(CARGO_MSRV_FLAGS)"; \
	  $(CARGO) +$(RUSTMSRV) check $(CARGO_MSRV_FLAGS) \
	    --manifest-path "$$SRCROOT/Cargo.toml" ); \
	rc=$$?; \
	if test $$rc -eq 0; then \
	  echo '		*** zlib Rust MSRV $(RUSTMSRV) check OK ***'; \
	else \
	  echo '		*** zlib Rust MSRV $(RUSTMSRV) check FAILED ***'; false; \
	fi

# Remove everything `rust' and `rust-test' produced: cargo's own output, and with
# it the packaged library, the relinked drivers and the symbol lists that all live
# under $(RUSTLIBDIR) inside $(RUSTTARGETDIR).  The names on the final `rm' are the
# scratch files the by-hand generated-header and symbol-parity commands leave in
# the build directory itself, which `.gitignore' also carries anchored rules for.
# This is deliberately not a prerequisite of `clean': `clean' is part of the C
# build and runs from `distclean', where cargo may well be missing.
#
# $(RUSTPATHGUARD) runs first and unconditionally.  $(RUSTTARGETDIR) is the
# operand of the only recursive delete in this file, it is overrideable, and
# `rm -rf' does not ask twice -- so the destination is proved to be a relative
# path resolving strictly beneath the build directory before the command is
# reached.  The guard is a separate recipe line so that it cannot be skipped by
# the `-' prefix on the line below, which exists only so that a missing cargo
# does not fail the target.
#
# Every directory this removes is checked first, because $(RUSTTARGETDIR) and
# $(RUSTLIBDIR) are overridable on the command line and this recipe deletes
# recursively.  A name is only accepted when it is relative, contains no `..'
# component, and resolves -- symlinks included -- to a path strictly inside the
# build directory.  Anything else is refused by name, with a nonzero status,
# rather than removed or silently skipped: `make rust-clean RUSTTARGETDIR=/'
# has to be an error, and a rust-clean that quietly cleaned nothing would leave
# a stale library staged for the next drop-in test to bind.
#
# ALL of that validation happens in the first loop, before anything is run or
# removed, and that ordering is the point.  `cargo clean' honours the same
# overridable $(RUSTTARGETDIR) through CARGO_TARGET_DIR and deletes it just as
# recursively as the `rm -rf' below does, so validating only immediately before
# the `rm -rf' would leave cargo to act on a path this recipe had already
# decided to refuse -- it would delete the directory and only then would the
# refusal be printed.  Measured: with the checks inline in the removal loop,
# `make rust-clean RUSTTARGETDIR=/tmp/somewhere/build' removed that directory
# and *then* reported that it was refusing to remove it.  Validate everything
# up front, act afterwards.
rust-clean:
	@set -e; \
	srcroot=`cd "$(SRCDIR)." && pwd`; \
	buildroot=`pwd -P`; \
	$(RUSTPATHGUARD); \
	for d in '$(RUSTTARGETDIR)' '$(RUSTLIBDIR)' '$(RUSTLIBDIR).new'; do \
	  test -n "$$d" || continue; \
	  case "$$d" in \
	    /* | ../* | */../* | */.. | ..) \
	      echo "make rust-clean: refusing to clean '$$d': it is not a plain" >&2; \
	      echo "make rust-clean: relative path inside the build directory." >&2; \
	      exit 1 ;; \
	  esac; \
	  test -e "$$d" || continue; \
	  if test ! -d "$$d"; then \
	    echo "make rust-clean: refusing to clean '$$d': not a directory" >&2; \
	    exit 1; \
	  fi; \
	  resolved=`cd "$$d" && pwd -P`; \
	  case "$$resolved" in \
	    "$$buildroot"/?*) ;; \
	    *) echo "make rust-clean: refusing to clean '$$d': it resolves to" >&2; \
	       echo "make rust-clean: $$resolved, outside $$buildroot." >&2; \
	       exit 1 ;; \
	  esac; \
	done; \
	if test -n "$(CARGO)"; then \
	  echo "$(CARGO) clean"; \
	  CARGO_TARGET_DIR='$(RUSTTARGETDIR)' \
	    $(CARGO) clean --manifest-path "$$srcroot/Cargo.toml" || true; \
	fi; \
	for d in '$(RUSTTARGETDIR)' '$(RUSTLIBDIR)' '$(RUSTLIBDIR).new'; do \
	  test -n "$$d" || continue; \
	  test -d "$$d" || continue; \
	  echo "rm -rf $$d"; \
	  rm -rf "$$d"; \
	done; \
	rm -f '$(RUSTHEADER)' $(RUSTHEADERSCRATCH) \
	      generated_zlib.h rust.syms c.syms missing.syms extra.syms

libz.a: $(OBJS)
	$(AR) $(ARFLAGS) $@ $(OBJS)
	-@ ($(RANLIB) $@ || true) >/dev/null 2>&1

match.o: match.S
	$(CPP) match.S > _match.s
	$(CC) -c _match.s
	mv _match.o match.o
	rm -f _match.s

match.lo: match.S
	$(CPP) match.S > _match.s
	$(CC) -c -fPIC _match.s
	mv _match.o match.lo
	rm -f _match.s

example.o: $(SRCDIR)test/example.c $(SRCDIR)zlib.h zconf.h
	$(CC) $(CFLAGS) $(ZINCOUT) -c -o $@ $(SRCDIR)test/example.c

minigzip.o: $(SRCDIR)test/minigzip.c $(SRCDIR)zlib.h zconf.h
