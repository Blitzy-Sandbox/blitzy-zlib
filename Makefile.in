minizip-test: static
	cd contrib/minizip && { CC="$(CC)" CFLAGS="$(CFLAGS)" $(MAKE) test ; cd ../.. ; }

minizip-clean:
	cd contrib/minizip && { $(MAKE) clean ; cd ../.. ; }

mostlyclean: clean
clean: minizip-clean
	rm -f *.o *.lo *~ \
	   example$(EXE) minigzip$(EXE) examplesh$(EXE) minigzipsh$(EXE) \
	   example64$(EXE) minigzip64$(EXE) \
	   infcover \
	   libz.* foo.gz so_locations \
	   _match.s maketree contrib/infback9/*.o
	rm -rf objs
	rm -f *.gcda *.gcno *.gcov
	rm -f contrib/infback9/*.gcda contrib/infback9/*.gcno contrib/infback9/*.gcov

maintainer-clean: distclean
# The printf sequence below regenerates the placeholder Makefile that tells the
# user to run ./configure.  It has to stay BYTE-IDENTICAL to the checked-in
# Makefile -- including the forwarding rule for every one of the seven rust*
# targets -- because a distclean replaces that file wholesale.  Drift here is not
# cosmetic: a forwarding rule that goes missing makes that target unreachable in
# a post-distclean tree, and $(RUSTTARGETDIR) is what a lost rust-clean would
# leave stranded, since that is the one Rust target needing nothing configure
# computes.  Every one of them works unconfigured -- they name the staged library
# from ZLIB_VERSION in the immutable $(SRCDIR)zlib.h rather than from the
# unconfigured $(SHAREDLIBV) default -- which is why they forward rather than
# refuse.  Regenerate this block from the checked-in Makefile rather than editing
# it by hand.
distclean: clean zconf # zconf.h.cmakein
	rm -f Makefile zlib.pc configure.log
	-@rm -f .DS_Store
	@if [ -f Makefile.in ]; then \
	printf 'all:\n\t-@echo "Please use ./configure first.  Thank you."\n' > Makefile ; \
	printf '\ndistclean:\n\tmake -f Makefile.in distclean\n' >> Makefile ; \
	printf '\n# The Rust targets work before ./configure has run, so they are forwarded\n' >> Makefile ; \
	printf '# rather than refused.  They stage a library named from the ZLIB_VERSION in\n' >> Makefile ; \
	printf "# zlib.h, not from Makefile.in's unconfigured SHAREDLIBV default, and they\n" >> Makefile ; \
	printf '# relink it through zlib.map with flags Makefile.in supplies itself, so the\n' >> Makefile ; \
	printf '# name, the SONAME and the 16 symbol version nodes are all right on this path\n' >> Makefile ; \
	printf "# too -- verified here: 111 dynamic globals, identical to the C library's.\n" >> Makefile ; \
	printf "# This file is regenerated by \`distclean'; keep it and that recipe in step.\n" >> Makefile ; \
	printf '#\n' >> Makefile ; \
	printf '# .PHONY IS REQUIRED, NOT TIDINESS: `rust'"'"' is also the name of a directory in\n' >> Makefile ; \
	printf '# this tree, and make treats a target whose name matches an existing file or\n' >> Makefile ; \
	printf '# directory as up to date when it has no prerequisites -- so without this line\n' >> Makefile ; \
	printf "# \`make rust' prints \"'rust' is up to date\", runs nothing and still exits 0.\n" >> Makefile ; \
	printf '# The whole family is declared, so a later addition cannot reintroduce it.\n' >> Makefile ; \
	printf '.PHONY: all distclean rust rust-pc rust-test rust-symbols rust-header rust-msrv rust-clean\n' >> Makefile ; \
	printf '\nrust:\n\t$$(MAKE) -f Makefile.in rust\n' >> Makefile ; \
	printf '\nrust-pc:\n\t$$(MAKE) -f Makefile.in rust-pc\n' >> Makefile ; \
	printf '\nrust-test:\n\t$$(MAKE) -f Makefile.in rust-test\n' >> Makefile ; \
	printf '\nrust-symbols:\n\t$$(MAKE) -f Makefile.in rust-symbols\n' >> Makefile ; \
	printf '\nrust-header:\n\t$$(MAKE) -f Makefile.in rust-header\n' >> Makefile ; \
	printf '\nrust-msrv:\n\t$$(MAKE) -f Makefile.in rust-msrv\n' >> Makefile ; \
	printf '\nrust-clean:\n\t$$(MAKE) -f Makefile.in rust-clean\n' >> Makefile ; \
	touch -r $(SRCDIR)Makefile.in Makefile ; fi

tags:
	etags $(SRCDIR)*.[ch]

